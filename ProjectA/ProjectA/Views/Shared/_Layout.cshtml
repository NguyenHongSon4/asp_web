    <script>
        // Map toggle
        function toggleMap() {
            var mc = document.getElementById("map-container");
            mc.style.display = mc.style.display === "none" ? "block" : "none";
        }

        // Mobile nav toggle (simple show/hide nav-links)
        function toggleMobileNav() {
            var links = document.querySelector('.nav-links');
            if (!links) return;
            if (links.style.display === 'flex') {
                links.style.display = 'none';
            } else {
                links.style.cssText = 'display:flex; flex-direction:column; position:fixed; top:64px; left:0; right:0; background:#fff; padding:12px 16px; gap:4px; z-index:1049; border-bottom:1px solid #eef0f6; box-shadow:0 8px 24px rgba(0,0,0,0.08);';
            }
        }

        // Search autocomplete
        function searchProducts() {
            var searchTerm = document.getElementById('searchTerm').value;
            if (searchTerm.length > 2) {
                $.ajax({
                    url: '@Url.Action("Search", "Home")',
                    type: 'GET',
                    data: { searchTerm: searchTerm },
                    success: function (data) {
                        if (data.trim() === '') {
                            $('#search-results-container').hide();
                        } else {
                            $('#search-results-container').html(data).show();
                        }
                    },
                    error: function () {
                        $('#search-results-container').html('<p style="padding:8px;font-size:13px;color:#888;">Lỗi khi tìm kiếm.</p>').show();
                    }
                });
            } else {
                $('#search-results-container').empty().hide();
            }
        }

        // Chuyển đến trang kết quả khi nhấn Enter
        function goToSearchPage() {
            var q = document.getElementById('searchTerm').value.trim();
            if (q.length > 0) {
                $('#search-results-container').hide();
                window.location.href = '/Customers/Home/SearchPage?q=' + encodeURIComponent(q);
            }
        }

        $(document).click(function (e) {
            if (!$(e.target).closest('#search-results-container').length && !$(e.target).is('#searchTerm')) {
                $('#search-results-container').hide();
            }
        });

        // Favorites AJAX
        $(document).ready(function () {
            $('.btn-add-to-favorites').click(function (e) {
                e.preventDefault();
                var sanPhamId = $(this).data('sanpham-id');
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("AddToFavorites", "FavoriteProduct")',
                    data: { sanPhamId: sanPhamId },
                    success: function (response) {
                        if (response.success) {
                            var toast = new bootstrap.Toast($('#toast'));
                            $('#toast .toast-body').text(response.message);
                            toast.show();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () { alert('Có lỗi xảy ra. Vui lòng thử lại sau.'); }
                });
            });

            $(document).on('click', '.add-to-favorites', function (e) {
                e.preventDefault();
                var sanPhamId = $(this).data('sanpham-id');
                $.ajax({
                    url: '/Customers/FavoriteProduct/AddToFavorites',
                    type: 'POST',
                    data: { sanPhamId: sanPhamId },
                    success: function (response) { alert(response.message); },
                    error: function (xhr) { alert('Lỗi: ' + xhr.status); }
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)


