@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Xác nhận quên mật khẩu";
}
<br />
<br />
<div class="container text-center">
    <h1 class="text-primary">@ViewData["Title"]</h1>
    <p class="text-muted">
        Vui lòng kiểm tra email của bạn để đặt lại mật khẩu.
    </p>
    <a asp-page="./Login" class="btn btn-lg btn-primary mt-3">Trở về trang đăng nhập</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* Centered Title Styling */
    h1 {
        font-weight: bold;
    }

    /* Button Styling */
    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        transition: background-color 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
        }

    /* Paragraph Styling */
    p {
        font-size: 1.1em;
    }
</style>
