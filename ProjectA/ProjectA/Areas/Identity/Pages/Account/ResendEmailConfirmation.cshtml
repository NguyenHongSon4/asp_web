@page
@model ResendEmailConfirmationModel
<br />
<br />
@{
    ViewData["Title"] = "Gửi lại xác nhận Email";
}

<h1 class="text-center text-primary mb-4">@ViewData["Title"]</h1>
<h2 class="text-center text-muted mb-4">Nhập địa chỉ Email của bạn để nhận lại xác nhận nhé!<h2>
<hr />

<div class="row justify-content-center">
    <div class="col-md-4">
        <form method="post" class="p-4 shadow-lg rounded bg-white">
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control shadow-sm border-0" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="text-muted">...</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary shadow-sm rounded" style="transition: 0.3s;">
                Gửi lại
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* Page and Heading Styling */
    h1 {
        font-weight: bold;
    }

    h2 {
        font-weight: normal;
    }

    /* Button Hover Effect */
    .btn-primary:hover {
        background-color: #0056b3;
        transform: translateY(-3px);
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
    }

    /* Input Field Styling */
    .form-floating .form-control {
        padding-top: 1.5rem;
        padding-bottom: 1rem;
        font-size: 1.05em;
    }

    .form-floating label {
        color: #666;
    }

    /* Validation Message Styling */
    .text-danger {
        font-size: 0.9em;
        font-weight: 500;
    }
</style>
