@page
@model LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Be Vietnam Pro', sans-serif;
        background: #f0f2f5;
        padding: 40px 20px;
        margin-top: -70px;
    }

    .auth-card {
        background: #fff;
        border-radius: 28px;
        padding: 44px 40px 36px;
        max-width: 440px;
        width: 100%;
        box-shadow: 0 8px 40px rgba(67,97,238,0.12);
        border: 1.5px solid #eef0f8;
    }

    /* ── Logo ── */
    .auth-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 8px;
    }

        .auth-logo .icon-wrap {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 22px;
            box-shadow: 0 6px 18px rgba(67,97,238,0.32);
        }

    .auth-logo-name {
        font-size: 26px;
        font-weight: 800;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: -0.5px;
    }

    .auth-title {
        font-size: 20px;
        font-weight: 700;
        color: #1a1a2e;
        text-align: center;
        margin: 14px 0 4px;
    }

    .auth-sub {
        font-size: 13.5px;
        color: #aaa;
        text-align: center;
        margin-bottom: 28px;
    }

    /* ── Validation ── */
    .auth-error {
        background: #fff0f1;
        border: 1.5px solid #ffc5c8;
        border-radius: 12px;
        padding: 11px 16px;
        font-size: 13px;
        color: #e63946;
        margin-bottom: 18px;
    }

    /* ── Form group ── */
    .auth-group {
        margin-bottom: 16px;
    }

        .auth-group label {
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #aaa;
            margin-bottom: 7px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .auth-group label i {
                color: #4361ee;
                font-size: 11px;
            }

    .auth-input {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1.5px solid #eee;
        border-radius: 12px;
        font-size: 14px;
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #1a1a2e;
        outline: none;
        background: #fafbff;
        transition: border-color 0.18s, box-shadow 0.18s;
    }

        .auth-input:focus {
            border-color: #4361ee;
            box-shadow: 0 0 0 3px rgba(67,97,238,0.1);
            background: #fff;
        }

        .auth-input::placeholder {
            color: #ccc;
        }

    /* Password wrap */
    .auth-pwd-wrap {
        position: relative;
    }

        .auth-pwd-wrap .auth-input {
            padding-right: 44px;
        }

    .auth-pwd-toggle {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #ccc;
        cursor: pointer;
        font-size: 14px;
        transition: color 0.18s;
    }

        .auth-pwd-toggle:hover {
            color: #4361ee;
        }

    .auth-field-error {
        font-size: 12px;
        color: #e63946;
        margin-top: 5px;
        display: block;
    }

    /* ── Remember me ── */
    .auth-remember {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        cursor: pointer;
    }

        .auth-remember input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #4361ee;
            cursor: pointer;
            flex-shrink: 0;
        }

        .auth-remember span {
            font-size: 13.5px;
            color: #666;
            font-weight: 500;
        }

    /* ── Divider ── */
    .auth-divider {
        border: none;
        border-top: 1.5px solid #f0f2f8;
        margin: 20px 0;
    }

    /* ── Submit ── */
    .auth-btn {
        width: 100%;
        height: 50px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 6px 20px rgba(67,97,238,0.32);
        transition: opacity 0.18s, transform 0.15s;
        margin-bottom: 20px;
    }

        .auth-btn:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    /* ── Links ── */
    .auth-links {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

        .auth-links a {
            font-size: 13px;
            color: #4361ee;
            font-weight: 600;
            text-decoration: none;
            transition: opacity 0.18s;
        }

            .auth-links a:hover {
                opacity: 0.75;
                text-decoration: underline;
            }

        .auth-links .auth-link-muted {
            color: #aaa;
            font-weight: 500;
        }

            .auth-links .auth-link-muted:hover {
                color: #4361ee;
            }

    .auth-footer {
        text-align: center;
        font-size: 13.5px;
        color: #888;
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1.5px solid #f0f2f8;
    }

        .auth-footer a {
            color: #4361ee;
            font-weight: 600;
            text-decoration: none;
        }

            .auth-footer a:hover {
                text-decoration: underline;
            }
</style>

<div class="auth-page">
    <div class="auth-card">

        <!-- Logo -->
        <div class="auth-logo">
            <div class="icon-wrap"><i class="fas fa-bolt"></i></div>
            <span class="auth-logo-name">DesBy</span>
        </div>
        <div class="auth-title">Chào mừng trở lại!</div>
        <div class="auth-sub">Đăng nhập để tiếp tục mua sắm cùng DesBy</div>

        <!-- Validation -->
        <div asp-validation-summary="ModelOnly" class="auth-error" style="display:none;"></div>

        <form id="account" method="post">
            @Html.AntiForgeryToken()

            <!-- Email -->
            <div class="auth-group">
                <label><i class="fas fa-envelope"></i> Email</label>
                <input asp-for="Input.Email" type="email" class="auth-input"
                       placeholder="example@email.com" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="auth-field-error"></span>
            </div>

            <!-- Mật khẩu -->
            <div class="auth-group">
                <label><i class="fas fa-lock"></i> Mật khẩu</label>
                <div class="auth-pwd-wrap">
                    <input asp-for="Input.Password" type="password" class="auth-input"
                           placeholder="Nhập mật khẩu..." autocomplete="current-password"
                           id="loginPwd" />
                    <i class="fas fa-eye auth-pwd-toggle"
                       onclick="togglePwd('loginPwd','loginPwdIcon')" id="loginPwdIcon"></i>
                </div>
                <span asp-validation-for="Input.Password" class="auth-field-error"></span>
            </div>

            <!-- Remember me -->
            <label class="auth-remember">
                <input asp-for="Input.RememberMe" type="checkbox" />
                <span>Ghi nhớ đăng nhập</span>
            </label>

            <hr class="auth-divider">

            <!-- Submit -->
            <button id="login-submit" type="submit" class="auth-btn">
                <i class="fas fa-sign-in-alt"></i> Đăng nhập
            </button>

            <!-- Links -->
            <div class="auth-links">
                <a id="forgot-password" asp-page="./ForgotPassword">
                    <i class="fas fa-key" style="font-size:11px;margin-right:4px;"></i>Quên mật khẩu?
                </a>
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="auth-link-muted">
                    Gửi lại xác nhận Email
                </a>
            </div>

            <div class="auth-footer">
                Chưa có tài khoản?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký ngay</a>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var summary = document.querySelector('.auth-error');
        if (summary && summary.querySelectorAll('li').length > 0) {
            summary.style.display = 'block';
        }
    });

    function togglePwd(inputId, iconId) {
        var input = document.getElementById(inputId);
        var icon  = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
