@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Be Vietnam Pro', sans-serif;
        background: #f0f2f5;
        padding: 40px 20px;
        margin-top: -70px; /* offset navbar */
    }

    .auth-card {
        background: #fff;
        border-radius: 28px;
        padding: 44px 40px 36px;
        max-width: 480px;
        width: 100%;
        box-shadow: 0 8px 40px rgba(67,97,238,0.12);
        border: 1.5px solid #eef0f8;
    }

    /* ── Header ── */
    .auth-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 8px;
    }

        .auth-logo .icon-wrap {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 22px;
            box-shadow: 0 6px 18px rgba(67,97,238,0.32);
        }

    .auth-logo-name {
        font-size: 26px;
        font-weight: 800;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: -0.5px;
    }

    .auth-title {
        font-size: 20px;
        font-weight: 700;
        color: #1a1a2e;
        text-align: center;
        margin: 14px 0 4px;
    }

    .auth-sub {
        font-size: 13.5px;
        color: #aaa;
        text-align: center;
        margin-bottom: 28px;
    }

    /* ── Validation ── */
    .auth-error {
        background: #fff0f1;
        border: 1.5px solid #ffc5c8;
        border-radius: 12px;
        padding: 11px 16px;
        font-size: 13px;
        color: #e63946;
        margin-bottom: 18px;
    }

        .auth-error ul {
            margin: 0;
            padding-left: 16px;
        }

    /* ── Form group ── */
    .auth-group {
        margin-bottom: 16px;
    }

        .auth-group label {
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #aaa;
            margin-bottom: 7px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .auth-group label i {
                color: #4361ee;
                font-size: 11px;
            }

    .auth-input {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1.5px solid #eee;
        border-radius: 12px;
        font-size: 14px;
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #1a1a2e;
        outline: none;
        background: #fafbff;
        transition: border-color 0.18s, box-shadow 0.18s;
    }

        .auth-input:focus {
            border-color: #4361ee;
            box-shadow: 0 0 0 3px rgba(67,97,238,0.1);
            background: #fff;
        }

        .auth-input::placeholder {
            color: #ccc;
        }

    /* Password wrap */
    .auth-pwd-wrap {
        position: relative;
    }

        .auth-pwd-wrap .auth-input {
            padding-right: 44px;
        }

    .auth-pwd-toggle {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #ccc;
        cursor: pointer;
        font-size: 14px;
        transition: color 0.18s;
    }

        .auth-pwd-toggle:hover {
            color: #4361ee;
        }

    .auth-field-error {
        font-size: 12px;
        color: #e63946;
        margin-top: 5px;
        display: block;
    }

    /* ── 2 col ── */
    .auth-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    @@media (max-width: 480px) {
        .auth-row {
            grid-template-columns: 1fr;
        }
    }

    /* ── Divider ── */
    .auth-divider {
        border: none;
        border-top: 1.5px solid #f0f2f8;
        margin: 22px 0;
    }

    /* ── Submit ── */
    .auth-btn {
        width: 100%;
        height: 50px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 6px 20px rgba(67,97,238,0.32);
        transition: opacity 0.18s, transform 0.15s;
        margin-bottom: 18px;
    }

        .auth-btn:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    /* ── Footer link ── */
    .auth-footer {
        text-align: center;
        font-size: 13.5px;
        color: #888;
    }

        .auth-footer a {
            color: #4361ee;
            font-weight: 600;
            text-decoration: none;
        }

            .auth-footer a:hover {
                text-decoration: underline;
            }
</style>

<div class="auth-page">
    <div class="auth-card">

        <!-- Logo -->
        <div class="auth-logo">
            <div class="icon-wrap"><i class="fas fa-bolt"></i></div>
            <span class="auth-logo-name">DesBy</span>
        </div>
        <div class="auth-title">Tạo tài khoản mới</div>
        <div class="auth-sub">Đăng ký để trải nghiệm mua sắm cùng DesBy</div>

        <!-- Validation errors -->
        <div asp-validation-summary="ModelOnly" class="auth-error" style="display:none;"></div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            @Html.AntiForgeryToken()

            <!-- Hidden role mặc định là User -->
            <input type="hidden" asp-for="Input.Role" value="User" />

            <!-- Tên + Địa chỉ -->
            <div class="auth-row">
                <div class="auth-group">
                    <label><i class="fas fa-user"></i> Họ tên</label>
                    <input asp-for="Input.Name" type="text" class="auth-input"
                           placeholder="Nguyễn Văn A" autocomplete="name" />
                    <span asp-validation-for="Input.Name" class="auth-field-error"></span>
                </div>
                <div class="auth-group">
                    <label><i class="fas fa-map-marker-alt"></i> Địa chỉ</label>
                    <input asp-for="Input.Address" type="text" class="auth-input"
                           placeholder="Số nhà, đường..." autocomplete="street-address" />
                    <span asp-validation-for="Input.Address" class="auth-field-error"></span>
                </div>
            </div>

            <!-- Email -->
            <div class="auth-group">
                <label><i class="fas fa-envelope"></i> Email</label>
                <input asp-for="Input.Email" type="email" class="auth-input"
                       placeholder="example@email.com" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="auth-field-error"></span>
            </div>

            <!-- Mật khẩu -->
            <div class="auth-group">
                <label><i class="fas fa-lock"></i> Mật khẩu</label>
                <div class="auth-pwd-wrap">
                    <input asp-for="Input.Password" type="password" class="auth-input"
                           placeholder="Tối thiểu 6 ký tự" autocomplete="new-password"
                           id="pwdInput" />
                    <i class="fas fa-eye auth-pwd-toggle" onclick="togglePwd('pwdInput','pwdIcon')" id="pwdIcon"></i>
                </div>
                <span asp-validation-for="Input.Password" class="auth-field-error"></span>
            </div>

            <!-- Xác nhận mật khẩu -->
            <div class="auth-group">
                <label><i class="fas fa-lock"></i> Xác nhận mật khẩu</label>
                <div class="auth-pwd-wrap">
                    <input asp-for="Input.ConfirmPassword" type="password" class="auth-input"
                           placeholder="Nhập lại mật khẩu" autocomplete="new-password"
                           id="cpwdInput" />
                    <i class="fas fa-eye auth-pwd-toggle" onclick="togglePwd('cpwdInput','cpwdIcon')" id="cpwdIcon"></i>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="auth-field-error"></span>
            </div>

            <hr class="auth-divider">

            <button id="registerSubmit" type="submit" class="auth-btn">
                <i class="fas fa-user-plus"></i> Tạo tài khoản
            </button>

            <div class="auth-footer">
                Đã có tài khoản?
                <a asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập ngay</a>
            </div>
        </form>
    </div>
</div>

<script>
    // Hiện validation summary nếu có lỗi
    document.addEventListener('DOMContentLoaded', function() {
        var summary = document.querySelector('.auth-error');
        if (summary && summary.querySelectorAll('li').length > 0) {
            summary.style.display = 'block';
        }
    });

    function togglePwd(inputId, iconId) {
        var input = document.getElementById(inputId);
        var icon  = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
