@page
@model ForgotPasswordModel
<br />
<br />
@{
    ViewData["Title"] = "Quên mật khẩu?";
}



<!-- Wrapper cho hình nền -->
<div class="background-wrapper d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <h1 class="text-center text-primary mb-4">@ViewData["Title"]</h1>
            <h4 class="text-center text-muted mb-4">Nhập Email để cập nhật lại mật khẩu</h4>
            <!-- Thay đổi cột về kích thước lớn hơn -->
            <form method="post" class="p-4 shadow-lg rounded bg-white">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="form-floating mb-4">
                    <input asp-for="Input.Email"
                           class="form-control shadow-sm border-0"
                           style="height: 55px; font-size: 1.1em; padding-left: 1.5rem; border-radius: 1rem;"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label text-muted" style="padding-left: 1.5rem;">Email...</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-primary shadow-sm" style="font-size: 1.2em; transition: 0.3s; height: 55px;">
                    Cập nhật lại
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    /* Thêm hình nền */
    .background-wrapper {
        background-image: url('https://i.pinimg.com/originals/4a/03/17/4a03178bfcc82b581bfbf3c3f649c577.gif'); /* Đường dẫn hình ảnh */
        background-size: cover;
        background-position: center;
        position: relative;
        height: 100vh; /* Chiều cao của khung nhìn */
        overflow: hidden;
    }

        /* Lớp phủ màu trắng mờ */
        .background-wrapper:before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.7); /* Màu trắng mờ */
            z-index: 1;
        }

    /* Nội dung bên trong khung */
    .row {
        position: relative;
        z-index: 2; /* Đặt nội dung phía trên lớp phủ */
    }

    /* Centered Title Styling */
    h1, h2 {
        color: #333;
        font-weight: 600;
    }

    /* Button Hover Effect */
    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

        .btn-primary:hover {
            background-color: #0056b3;
            transform: translateY(-3px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
        }

    /* Input Field Styling */
    .form-floating .form-control {
        padding-top: 1.5rem;
        padding-bottom: 1rem;
        border-radius: 1rem; /* Bo tròn cho ô nhập liệu */
    }

    .form-floating label {
        color: #666;
    }

    /* Validation Message Styling */
    .text-danger {
        font-weight: 500;
        font-size: 0.9em;
    }

    /* Smooth Transition for Focus */
    .form-control:focus {
        box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
        border-color: #80bdff;
    }
</style>
