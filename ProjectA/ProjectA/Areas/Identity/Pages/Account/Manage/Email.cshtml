@page
@model EmailModel
@{
    ViewData["Title"] = "Quản lý Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .profile-wrap {
        font-family: 'Be Vietnam Pro', sans-serif;
        max-width: 520px;
        margin: 0 auto;
        padding-bottom: 60px;
        color: #1a1a2e;
    }

    /* ── Header ── */
    .profile-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

        .profile-header .icon-wrap {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 19px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        }

        .profile-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

        .profile-header p {
            font-size: 13px;
            color: #aaa;
            margin: 2px 0 0;
        }

    /* ── Avatar ── */
    .profile-avatar-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 28px;
    }

    .profile-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 30px;
        font-weight: 700;
        box-shadow: 0 6px 20px rgba(67,97,238,0.3);
        margin-bottom: 10px;
    }

    .profile-username {
        font-size: 16px;
        font-weight: 700;
        color: #1a1a2e;
    }

    .profile-email-badge {
        font-size: 12.5px;
        color: #aaa;
        margin-top: 2px;
    }

    /* ── Status message ── */
    .profile-status-ok {
        background: #f0fdf4;
        border: 1.5px solid #a7f3d0;
        border-radius: 12px;
        padding: 11px 16px;
        font-size: 13px;
        color: #10b981;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .profile-status-err {
        background: #fff0f1;
        border: 1.5px solid #ffc5c8;
        border-radius: 12px;
        padding: 11px 16px;
        font-size: 13px;
        color: #e63946;
        margin-bottom: 20px;
    }

    /* ── Panel ── */
    .profile-panel {
        background: #fff;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 2px 24px rgba(0,0,0,0.07);
        border: 1.5px solid #eef0f8;
    }

    /* ── Section ── */
    .profile-section {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #bbb;
        margin: 0 0 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .profile-section i {
            color: #4361ee;
        }

    /* ── Form group ── */
    .profile-group {
        margin-bottom: 18px;
    }

        .profile-group label {
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #aaa;
            margin-bottom: 7px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .profile-group label i {
                color: #4361ee;
                font-size: 11px;
            }

    .profile-input {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1.5px solid #eee;
        border-radius: 12px;
        font-size: 14px;
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #1a1a2e;
        outline: none;
        background: #fafbff;
        transition: border-color 0.18s, box-shadow 0.18s;
    }

        .profile-input:focus {
            border-color: #4361ee;
            box-shadow: 0 0 0 3px rgba(67,97,238,0.1);
            background: #fff;
        }

        .profile-input:disabled {
            background: #f5f5f8;
            color: #aaa;
            cursor: not-allowed;
            border-color: #eee;
        }

        .profile-input::placeholder {
            color: #ccc;
        }

    .profile-field-error {
        font-size: 12px;
        color: #e63946;
        margin-top: 5px;
        display: block;
    }

    /* ── Divider ── */
    .profile-divider {
        border: none;
        border-top: 1.5px solid #f0f2f8;
        margin: 22px 0;
    }

    /* ── Submit ── */
    .profile-btn {
        width: 100%;
        height: 48px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        transition: opacity 0.18s, transform 0.15s;
    }

        .profile-btn:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }
</style>

<div class="profile-wrap">

    <!-- Header -->
    <div class="profile-header">
        <div class="icon-wrap"><i class="fas fa-envelope"></i></div>
        <div>
            <h2>Quản lý Email</h2>
            <p>Xem và cập nhật địa chỉ email của bạn</p>
        </div>
    </div>

    <!-- Status message -->
    <partial name="_StatusMessage" for="StatusMessage" />

    <!-- Panel -->
    <div class="profile-panel">

        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="profile-status-err" style="display:none;"></div>

            <!-- Email hiện tại -->
            <div class="profile-section"><i class="fas fa-envelope-open"></i> Email hiện tại</div>

            @if (Model.IsEmailConfirmed)
            {
                <div class="profile-group">
                    <label><i class="fas fa-envelope"></i> Email</label>
                    <div style="position:relative;">
                        <input asp-for="Email" class="profile-input" disabled
                               style="padding-right: 48px;" />
                        <span style="position:absolute;right:14px;top:50%;transform:translateY(-50%);
                                         background:#f0fdf4;color:#10b981;border:1.5px solid #a7f3d0;
                                         border-radius:8px;padding:2px 10px;font-size:12px;font-weight:700;">
                            ✓ Đã xác nhận
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="profile-group">
                    <label><i class="fas fa-envelope"></i> Email</label>
                    <input asp-for="Email" class="profile-input" disabled />
                    <div style="margin-top:8px;background:#fffbeb;border:1.5px solid #fde68a;
                                    border-radius:10px;padding:10px 14px;
                                    display:flex;align-items:center;justify-content:space-between;gap:10px;">
                        <span style="font-size:12.5px;color:#d97706;font-weight:500;">
                            <i class="fas fa-exclamation-triangle" style="margin-right:5px;"></i>
                            Email chưa được xác nhận
                        </span>
                        <button id="email-verification" type="submit"
                                asp-page-handler="SendVerificationEmail"
                                style="height:32px;padding:0 14px;border-radius:9px;border:none;
                                           background:#d97706;color:#fff;font-size:12px;font-weight:600;
                                           font-family:'Be Vietnam Pro',sans-serif;cursor:pointer;
                                           transition:opacity 0.18s;white-space:nowrap;"
                                onmouseover="this.style.opacity='0.85'"
                                onmouseout="this.style.opacity='1'">
                            <i class="fas fa-paper-plane"></i> Gửi xác nhận
                        </button>
                    </div>
                </div>
            }

            <hr class="profile-divider">

            <!-- Email mới -->
            <div class="profile-section"><i class="fas fa-edit"></i> Đổi email mới</div>

            <div class="profile-group">
                <label><i class="fas fa-at"></i> Email mới</label>
                <input asp-for="Input.NewEmail" type="email" class="profile-input"
                       autocomplete="email" placeholder="Nhập địa chỉ email mới..." />
                <span asp-validation-for="Input.NewEmail" class="profile-field-error"></span>
            </div>

            <hr class="profile-divider">

            <button id="change-email-button" type="submit"
                    asp-page-handler="ChangeEmail" class="profile-btn">
                <i class="fas fa-paper-plane"></i> Cập nhật email
            </button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var summary = document.querySelector('.profile-status-err');
        if (summary && summary.querySelectorAll('li').length > 0) {
            summary.style.display = 'block';
        }
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
