@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .profile-wrap {
        font-family: 'Be Vietnam Pro', sans-serif;
        max-width: 520px;
        margin: 0 auto;
        padding-bottom: 60px;
        color: #1a1a2e;
    }

    /* ── Header ── */
    .profile-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

        .profile-header .icon-wrap {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 19px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        }

        .profile-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

        .profile-header p {
            font-size: 13px;
            color: #aaa;
            margin: 2px 0 0;
        }

    /* ── Avatar ── */
    .profile-avatar-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 28px;
    }

    .profile-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 30px;
        font-weight: 700;
        box-shadow: 0 6px 20px rgba(67,97,238,0.3);
        margin-bottom: 10px;
    }

    .profile-username {
        font-size: 16px;
        font-weight: 700;
        color: #1a1a2e;
    }

    .profile-email-badge {
        font-size: 12.5px;
        color: #aaa;
        margin-top: 2px;
    }

    /* ── Status message ── */
    .profile-status-ok {
        background: #f0fdf4;
        border: 1.5px solid #a7f3d0;
        border-radius: 12px;
        padding: 11px 16px;
        font-size: 13px;
        color: #10b981;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .profile-status-err {
        background: #fff0f1;
        border: 1.5px solid #ffc5c8;
        border-radius: 12px;
        padding: 11px 16px;
        font-size: 13px;
        color: #e63946;
        margin-bottom: 20px;
    }

    /* ── Panel ── */
    .profile-panel {
        background: #fff;
        border-radius: 24px;
        padding: 30px;
        box-shadow: 0 2px 24px rgba(0,0,0,0.07);
        border: 1.5px solid #eef0f8;
    }

    /* ── Section ── */
    .profile-section {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #bbb;
        margin: 0 0 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .profile-section i {
            color: #4361ee;
        }

    /* ── Form group ── */
    .profile-group {
        margin-bottom: 18px;
    }

        .profile-group label {
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #aaa;
            margin-bottom: 7px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .profile-group label i {
                color: #4361ee;
                font-size: 11px;
            }

    .profile-input {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1.5px solid #eee;
        border-radius: 12px;
        font-size: 14px;
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #1a1a2e;
        outline: none;
        background: #fafbff;
        transition: border-color 0.18s, box-shadow 0.18s;
    }

        .profile-input:focus {
            border-color: #4361ee;
            box-shadow: 0 0 0 3px rgba(67,97,238,0.1);
            background: #fff;
        }

        .profile-input:disabled {
            background: #f5f5f8;
            color: #aaa;
            cursor: not-allowed;
            border-color: #eee;
        }

        .profile-input::placeholder {
            color: #ccc;
        }

    .profile-field-error {
        font-size: 12px;
        color: #e63946;
        margin-top: 5px;
        display: block;
    }

    /* ── Divider ── */
    .profile-divider {
        border: none;
        border-top: 1.5px solid #f0f2f8;
        margin: 22px 0;
    }

    /* ── Submit ── */
    .profile-btn {
        width: 100%;
        height: 48px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        transition: opacity 0.18s, transform 0.15s;
    }

        .profile-btn:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }
</style>

<div class="profile-wrap">

    <!-- Header -->
    <div class="profile-header">
        <div class="icon-wrap"><i class="fas fa-shield-alt"></i></div>
        <div>
            <h2>Đổi mật khẩu</h2>
            <p>Cập nhật mật khẩu để bảo vệ tài khoản</p>
        </div>
    </div>

    <!-- Status message -->
    <partial name="_StatusMessage" for="StatusMessage" />

    <!-- Panel -->
    <div class="profile-panel">

        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="profile-status-err" style="display:none;"></div>

            <div class="profile-section"><i class="fas fa-lock"></i> Mật khẩu</div>

            <!-- Mật khẩu hiện tại -->
            <div class="profile-group">
                <label><i class="fas fa-lock"></i> Mật khẩu hiện tại</label>
                <div class="auth-pwd-wrap" style="position:relative;">
                    <input asp-for="Input.OldPassword" type="password" class="profile-input"
                           autocomplete="current-password"
                           placeholder="Nhập mật khẩu hiện tại..."
                           id="oldPwd" style="padding-right:44px;" />
                    <i class="fas fa-eye auth-pwd-toggle"
                       onclick="togglePwd('oldPwd','oldPwdIcon')" id="oldPwdIcon"
                       style="position:absolute;right:14px;top:50%;transform:translateY(-50%);
                              color:#ccc;cursor:pointer;font-size:14px;transition:color 0.18s;"></i>
                </div>
                <span asp-validation-for="Input.OldPassword" class="profile-field-error"></span>
            </div>

            <hr class="profile-divider">

            <div class="profile-section"><i class="fas fa-key"></i> Mật khẩu mới</div>

            <!-- Mật khẩu mới -->
            <div class="profile-group">
                <label><i class="fas fa-lock"></i> Mật khẩu mới</label>
                <div style="position:relative;">
                    <input asp-for="Input.NewPassword" type="password" class="profile-input"
                           autocomplete="new-password"
                           placeholder="Tối thiểu 6 ký tự..."
                           id="newPwd" style="padding-right:44px;" />
                    <i class="fas fa-eye"
                       onclick="togglePwd('newPwd','newPwdIcon')" id="newPwdIcon"
                       style="position:absolute;right:14px;top:50%;transform:translateY(-50%);
                              color:#ccc;cursor:pointer;font-size:14px;transition:color 0.18s;"></i>
                </div>
                <span asp-validation-for="Input.NewPassword" class="profile-field-error"></span>
            </div>

            <!-- Xác nhận mật khẩu mới -->
            <div class="profile-group">
                <label><i class="fas fa-lock"></i> Xác nhận mật khẩu mới</label>
                <div style="position:relative;">
                    <input asp-for="Input.ConfirmPassword" type="password" class="profile-input"
                           autocomplete="new-password"
                           placeholder="Nhập lại mật khẩu mới..."
                           id="cfPwd" style="padding-right:44px;" />
                    <i class="fas fa-eye"
                       onclick="togglePwd('cfPwd','cfPwdIcon')" id="cfPwdIcon"
                       style="position:absolute;right:14px;top:50%;transform:translateY(-50%);
                              color:#ccc;cursor:pointer;font-size:14px;transition:color 0.18s;"></i>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="profile-field-error"></span>
            </div>

            <hr class="profile-divider">

            <button type="submit" class="profile-btn">
                <i class="fas fa-shield-alt"></i> Cập nhật mật khẩu
            </button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var summary = document.querySelector('.profile-status-err');
        if (summary && summary.querySelectorAll('li').length > 0) {
            summary.style.display = 'block';
        }
    });

    function togglePwd(inputId, iconId) {
        var input = document.getElementById(inputId);
        var icon  = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
            icon.style.color = '#4361ee';
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
            icon.style.color = '#ccc';
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
