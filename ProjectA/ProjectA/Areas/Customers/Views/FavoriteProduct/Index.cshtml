@model IEnumerable<ProjectA.Models.SanPhamYeuThich>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .fav-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px 80px;
        font-family: 'Be Vietnam Pro', sans-serif;
    }

    /* ── Page header ── */
    .fav-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .fav-title {
        font-size: 22px;
        font-weight: 700;
        color: #1a1a2e;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
    }

        .fav-title .icon-wrap {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #e63946, #c1121f);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 17px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(230,57,70,0.3);
        }

    .fav-count-badge {
        background: #fff0f1;
        color: #e63946;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        border: 1.5px solid #ffc5c8;
    }

    /* ── Empty state ── */
    .fav-empty {
        text-align: center;
        padding: 80px 20px;
        background: #fff;
        border-radius: 24px;
        border: 1.5px dashed #e0e3f0;
    }

    .fav-empty-icon {
        font-size: 52px;
        color: #e0e3f0;
        margin-bottom: 16px;
    }

    .fav-empty h3 {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 8px;
    }

    .fav-empty p {
        font-size: 14px;
        color: #aaa;
        margin-bottom: 24px;
    }

    .fav-empty-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 28px;
        border-radius: 50px;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        transition: opacity 0.18s, transform 0.15s;
    }

        .fav-empty-btn:hover {
            opacity: 0.9;
            transform: translateY(-2px);
            color: #fff;
        }

    /* ── Grid ── */
    .fav-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 20px;
    }

    /* ── Card ── */
    .fav-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        border: 1.5px solid #eef0f8;
        overflow: hidden;
        transition: transform 0.22s, box-shadow 0.22s;
        display: flex;
        flex-direction: column;
    }

        .fav-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 36px rgba(67,97,238,0.12);
        }

    /* Image */
    .fav-card-img-wrap {
        position: relative;
        overflow: hidden;
        height: 200px;
        background: #f5f5f8;
        flex-shrink: 0;
    }

        .fav-card-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s cubic-bezier(.25,.46,.45,.94);
            display: block;
        }

    .fav-card:hover .fav-card-img-wrap img {
        transform: scale(1.07);
    }

    /* Heart overlay */
    .fav-card-heart {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(255,255,255,0.92);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e63946;
        font-size: 15px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }

    /* Body */
    .fav-card-body {
        padding: 18px 18px 16px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .fav-card-name {
        font-size: 14px;
        font-weight: 600;
        color: #1a1a2e;
        margin-bottom: 6px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.5;
    }

    .fav-card-price {
        font-size: 16px;
        font-weight: 700;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 16px;
    }

    /* Actions */
    .fav-card-actions {
        display: flex;
        gap: 8px;
        margin-top: auto;
    }

    .btn-fav-detail {
        flex: 1;
        padding: 10px;
        border-radius: 12px;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: opacity 0.18s, transform 0.15s;
        box-shadow: 0 3px 10px rgba(67,97,238,0.25);
    }

        .btn-fav-detail:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            color: #fff;
        }

    .btn-fav-remove {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: #fff0f1;
        border: 1.5px solid #ffc5c8;
        color: #e63946;
        font-size: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: background 0.18s, color 0.18s, border-color 0.18s;
        flex-shrink: 0;
    }

        .btn-fav-remove:hover {
            background: #e63946;
            color: #fff;
            border-color: #e63946;
        }

    @@media (max-width: 576px) {
        .fav-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .fav-card-img-wrap {
            height: 150px;
        }
    }
</style>

<div class="fav-wrap">

    <!-- Header -->
    <div class="fav-header">
        <h2 class="fav-title">
            <span class="icon-wrap"><i class="fas fa-heart"></i></span>
            Danh sách yêu thích
        </h2>
        @{
            int favCount = Model?.Count() ?? 0;
        }
        <span class="fav-count-badge">@favCount sản phẩm</span>
    </div>

    @if (!Model.Any())
    {
        <!-- Empty state -->
        <div class="fav-empty">
            <div class="fav-empty-icon"><i class="fas fa-heart-broken"></i></div>
            <h3>Chưa có sản phẩm yêu thích</h3>
            <p>Hãy khám phá và thêm những sản phẩm bạn yêu thích vào đây nhé!</p>
            <a href="/" class="fav-empty-btn">
                <i class="fas fa-store"></i> Khám phá ngay
            </a>
        </div>
    }
    else
    {
        <div class="fav-grid">
            @foreach (var item in Model)
            {
                <div class="fav-card">
                    <!-- Image -->
                    <div class="fav-card-img-wrap">
                        <a asp-controller="Home" asp-action="Details" asp-route-sanPhamId="@item.SanPhamId">
                            <img src="@item.SanPham.ImageUrl" alt="@item.SanPham.Name" />
                        </a>
                        <div class="fav-card-heart">
                            <i class="fas fa-heart"></i>
                        </div>
                    </div>

                    <!-- Body -->
                    <div class="fav-card-body">
                        <div class="fav-card-name">@item.SanPham.Name</div>
                        <div class="fav-card-price">
                            @item.SanPham.price.ToString("N0").Replace("'", ".")đ
                        </div>
                        <div class="fav-card-actions">
                            <a asp-controller="Home" asp-action="Details"
                               asp-route-sanPhamId="@item.SanPhamId"
                               class="btn-fav-detail">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </a>
                            <a asp-action="RemoveFromFavorites" asp-route-id="@item.Id"
                               class="btn-fav-remove" title="Xoá khỏi yêu thích">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
