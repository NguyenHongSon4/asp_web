@model GioHangViewModel
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    * {
        box-sizing: border-box;
    }

    body {
        background: #f0f2f5;
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #1a1a2e;
    }

    /* ── Breadcrumb ── */
    .breadcrumb {
        background: transparent;
        padding: 0;
        margin-bottom: 0;
        font-size: 13px;
        color: #888;
    }

    .breadcrumb-item a {
        color: #4361ee;
        text-decoration: none;
        transition: color 0.2s;
    }

        .breadcrumb-item a:hover {
            color: #3a0ca3;
        }

    .breadcrumb-item.active {
        color: #888;
    }

    /* ── Layout ── */
    .gh-wrapper {
        max-width: 1180px;
        margin: 0 auto;
        padding: 32px 20px 60px;
    }

    .gh-page-title {
        font-size: 22px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .gh-page-title .icon-wrap {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 17px;
        }

    /* ── Cart Table Panel ── */
    .gh-panel {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 2px 20px rgba(0,0,0,0.06);
        overflow: hidden;
        margin-bottom: 24px;
    }

    .gh-panel-header {
        padding: 20px 28px 0;
        font-size: 14px;
        font-weight: 600;
        color: #888;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .gh-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .gh-table thead tr {
            border-bottom: 1.5px solid #f0f2f5;
        }

        .gh-table th {
            padding: 14px 18px;
            font-weight: 600;
            font-size: 12px;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            text-align: center;
            background: #fff;
        }

            .gh-table th:first-child {
                text-align: left;
            }

        .gh-table tbody tr {
            border-bottom: 1px solid #f5f5f8;
            transition: background 0.18s;
        }

            .gh-table tbody tr:last-child {
                border-bottom: none;
            }

            .gh-table tbody tr:hover {
                background: #fafbff;
            }

        .gh-table td {
            padding: 16px 18px;
            vertical-align: middle;
            text-align: center;
        }

            .gh-table td:first-child {
                text-align: left;
            }

    /* Product cell */
    .product-cell {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .product-img {
        width: 64px;
        height: 64px;
        border-radius: 12px;
        object-fit: cover;
        border: 1px solid #eee;
        background: #f5f5f8;
        flex-shrink: 0;
    }

    .product-name {
        font-weight: 600;
        font-size: 14px;
        color: #1a1a2e;
        line-height: 1.4;
    }

    .product-id {
        font-size: 12px;
        color: #bbb;
        margin-top: 2px;
    }

    /* Price */
    .price-cell {
        font-weight: 500;
        color: #555;
        white-space: nowrap;
    }

    .total-cell {
        font-weight: 700;
        color: #4361ee;
        white-space: nowrap;
    }

    /* Quantity control */
    .qty-control {
        display: inline-flex;
        align-items: center;
        background: #f5f5f8;
        border-radius: 50px;
        padding: 4px;
        gap: 2px;
    }

    .qty-btn {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        background: #fff;
        color: #4361ee;
        font-size: 16px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        transition: background 0.18s, color 0.18s, transform 0.12s;
        text-decoration: none;
        line-height: 1;
    }

        .qty-btn:hover {
            background: #4361ee;
            color: #fff;
            transform: scale(1.08);
        }

    .qty-input {
        width: 38px;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
        border: none;
        background: transparent;
        color: #1a1a2e;
        pointer-events: none;
    }

    /* Delete btn */
    .btn-delete {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        border: none;
        background: #fff0f0;
        color: #e63946;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.18s, color 0.18s, transform 0.12s;
        text-decoration: none;
    }

        .btn-delete:hover {
            background: #e63946;
            color: #fff;
            transform: scale(1.08);
        }

    /* ── Checkout Panel ── */
    .checkout-panel {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 2px 20px rgba(0,0,0,0.06);
        padding: 28px;
        position: sticky;
        top: 20px;
    }

    .checkout-title {
        font-size: 16px;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .checkout-title i {
            color: #4361ee;
        }

    /* Total row */
    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 0;
        border-top: 1.5px solid #f0f2f5;
        margin-top: 4px;
    }

        .total-row .label {
            font-size: 13px;
            color: #888;
            font-weight: 500;
        }

        .total-row .value {
            font-size: 20px;
            font-weight: 700;
            color: #4361ee;
        }

    /* Payment methods */
    .section-label {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #aaa;
        margin: 20px 0 10px;
    }

    .pay-method-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .pay-method-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 14px;
        border: 1.5px solid #eee;
        border-radius: 12px;
        cursor: pointer;
        transition: border-color 0.18s, background 0.18s;
    }

        .pay-method-item:hover {
            border-color: #4361ee;
            background: #f6f8ff;
        }

        .pay-method-item input[type="radio"] {
            accent-color: #4361ee;
            width: 16px;
            height: 16px;
            flex-shrink: 0;
            cursor: pointer;
        }

        .pay-method-item label {
            font-size: 13.5px;
            font-weight: 500;
            color: #333;
            cursor: pointer;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pay-method-item label i {
                color: #4361ee;
                font-size: 15px;
                width: 18px;
                text-align: center;
            }

    /* Coupon */
    .coupon-row {
        display: flex;
        gap: 8px;
        margin-top: 18px;
    }

    .coupon-input {
        flex: 1;
        padding: 10px 14px;
        border: 1.5px solid #eee;
        border-radius: 10px;
        font-size: 13px;
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #333;
        transition: border-color 0.18s;
        outline: none;
    }

        .coupon-input:focus {
            border-color: #4361ee;
        }

        .coupon-input::placeholder {
            color: #bbb;
        }

    .coupon-btn {
        padding: 10px 14px;
        background: #f0f2ff;
        border: 1.5px solid #c5caff;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        color: #4361ee;
        cursor: pointer;
        white-space: nowrap;
        font-family: 'Be Vietnam Pro', sans-serif;
        transition: background 0.18s, color 0.18s;
    }

        .coupon-btn:hover {
            background: #4361ee;
            color: #fff;
            border-color: #4361ee;
        }

    /* Payment extra info areas */
    #payment-info p {
        font-size: 13px;
        color: #777;
        margin: 10px 0 0;
    }

    #payment-credit-card,
    #ewallet-info {
        margin-top: 14px;
        background: #f9fafe;
        border: 1.5px dashed #d0d8f5;
        border-radius: 12px;
        padding: 16px;
    }

        #payment-credit-card h3,
        #ewallet-info h6 {
            font-size: 13px;
            font-weight: 700;
            color: #4361ee;
            margin-bottom: 12px;
        }

        #payment-credit-card label {
            font-size: 12px;
            color: #888;
            font-weight: 600;
            margin-bottom: 4px;
            display: block;
        }

        #payment-credit-card input[type="text"] {
            width: 100%;
            padding: 9px 12px;
            border: 1.5px solid #dde2f5;
            border-radius: 8px;
            font-size: 13px;
            font-family: 'Be Vietnam Pro', sans-serif;
            margin-bottom: 12px;
            outline: none;
            transition: border-color 0.18s;
        }

            #payment-credit-card input[type="text"]:focus {
                border-color: #4361ee;
            }

        #ewallet-info p {
            font-size: 13px;
            color: #666;
            margin: 0;
        }

    /* Order button */
    .btn-order {
        display: block;
        width: 100%;
        margin-top: 22px;
        padding: 14px;
        border-radius: 14px;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        font-family: 'Be Vietnam Pro', sans-serif;
        border: none;
        cursor: pointer;
        letter-spacing: 0.03em;
        transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
        box-shadow: 0 4px 16px rgba(67,97,238,0.3);
    }

        .btn-order:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(67,97,238,0.4);
            color: #fff;
        }

        .btn-order i {
            margin-right: 8px;
        }

    /* ── Empty state ── */
    .empty-cart {
        text-align: center;
        padding: 60px 20px;
        color: #bbb;
    }

        .empty-cart i {
            font-size: 56px;
            margin-bottom: 16px;
            color: #ddd;
        }

        .empty-cart p {
            font-size: 16px;
            font-weight: 500;
        }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .gh-table thead {
            display: none;
        }

        .gh-table tr {
            display: block;
            padding: 16px;
            border-bottom: 1px solid #f0f2f5;
        }

        .gh-table td {
            display: block;
            text-align: left;
            padding: 4px 0;
        }

        .product-cell {
            flex-direction: column;
            align-items: flex-start;
        }

        .checkout-panel {
            position: static;
            margin-top: 16px;
        }
    }
</style>

<div class="gh-wrapper">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" style="margin-bottom: 20px;">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Trang Chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Giỏ hàng</li>
        </ol>
    </nav>

    <div class="gh-page-title">
        <span class="icon-wrap"><i class="fas fa-shopping-cart"></i></span>
        Giỏ hàng của bạn
    </div>

    <div class="row g-4">

        <!-- ── Cart Items ── -->
        <div class="col-lg-8">
            <div class="gh-panel">
                <div class="gh-panel-header">Sản phẩm</div>
                <div class="table-responsive">
                    <table class="gh-table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                double tongtien = 0;
                            }
                            @if (Model.DsGioHang == null || !Model.DsGioHang.Any())
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="empty-cart">
                                            <i class="fas fa-shopping-cart"></i>
                                            <p>Giỏ hàng của bạn đang trống</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.DsGioHang)
                                {
                                    tongtien += item.SanPham.price * item.Quantity;
                                    <tr data-price="@item.SanPham.price">
                                        <td>
                                            <div class="product-cell">
                                                <img src="@item.SanPham.ImageUrl" alt="@item.SanPham.Name" class="product-img" />
                                                <div>
                                                    <div class="product-name">@item.SanPham.Name</div>
                                                    <div class="product-id">#@item.SanPham.Id</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="price-cell">@item.SanPham.price.ToString("N0").Replace("'", ".")đ</td>
                                        <td>
                                            <div class="qty-control">
                                                <a class="qty-btn minus" asp-action="Giam" asp-route-giohangId="@item.Id">−</a>
                                                <input type="text" class="qty-input quantity" value="@item.Quantity" readonly />
                                                <a class="qty-btn plus" asp-action="Tang" asp-route-giohangId="@item.Id">+</a>
                                            </div>
                                        </td>
                                        <td class="total-cell item-total">
                                            @((item.SanPham.price * item.Quantity).ToString("N0").Replace("'", "."))đ
                                        </td>
                                        <td>
                                            <a asp-action="Xoa" asp-route-giohangId="@item.Id" class="btn-delete remove" title="Xóa sản phẩm">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ── Checkout Panel ── -->
        <div class="col-lg-4">
            <div class="checkout-panel">
                <div class="checkout-title">
                    <i class="fas fa-receipt"></i> Thanh toán
                </div>

                <!-- Total -->
                <div class="total-row">
                    <span class="label">Tổng cộng</span>
                    <span class="value" id="cart-total">@Model.HoaDon.Total.ToString("N0").Replace("'", ".")đ</span>
                </div>

                <!-- Payment methods -->
                <div class="section-label">Phương thức thanh toán</div>
                <div class="pay-method-group">
                    <div class="pay-method-item">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="paymentCOD" checked onclick="showPaymentInfo('COD')">
                        <label for="paymentCOD">
                            <i class="fas fa-hand-holding-usd"></i> Thanh toán khi nhận hàng
                        </label>
                    </div>
                    <div class="pay-method-item">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="paymentCard" onclick="showPaymentInfo('Card')">
                        <label for="paymentCard">
                            <i class="fas fa-university"></i> Thẻ ngân hàng
                        </label>
                    </div>
                    <div class="pay-method-item">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="paymentEwallet" onclick="showPaymentInfo('Ewallet')">
                        <label for="paymentEwallet">
                            <i class="fas fa-mobile-alt"></i> Ví điện tử
                        </label>
                    </div>
                </div>

                <!-- Payment detail areas (preserved exactly) -->
                <div id="payment-info" class="mt-2"></div>

                <div id="payment-credit-card" class="payment-method d-none">
                    <h3><i class="fas fa-credit-card"></i> Thông tin thẻ tín dụng</h3>
                    <label for="cardname"><i class="fas fa-user"></i> Tên trên thẻ</label>
                    <input type="text" id="cardname" placeholder="Nhập tên trên thẻ">
                    <label for="ccnum"><i class="fas fa-credit-card"></i> Số thẻ</label>
                    <input type="text" id="ccnum" placeholder="1111-2222-3333-4444">
                    <label for="expmonth"><i class="fas fa-calendar-alt"></i> Tháng hết hạn</label>
                    <input type="text" id="expmonth" placeholder="Tháng">
                    <label for="expyear"><i class="fas fa-calendar-alt"></i> Năm hết hạn</label>
                    <input type="text" id="expyear" placeholder="Năm">
                    <label for="cvv"><i class="fas fa-lock"></i> CVV</label>
                    <input type="text" id="cvv" placeholder="CVV">
                </div>

                <div id="ewallet-info" class="payment-method d-none">
                    <h6><i class="fas fa-wallet"></i> Ví điện tử</h6>
                    <p>Hỗ trợ ZaloPay, Momo, ApplePay và các ví phổ biến khác.</p>
                </div>

                <!-- Coupon -->
                <div class="section-label" style="margin-top:22px;">Mã giảm giá</div>
                <div class="coupon-row">
                    <input type="text" class="coupon-input" placeholder="Nhập mã giảm giá...">
                    <button class="coupon-btn" type="button"><i class="fas fa-tag"></i> Áp dụng</button>
                </div>

                <!-- Order button -->
                <a class="btn-order" asp-action="ThanhToan">
                    <i class="fas fa-lock"></i> Đặt hàng ngay
                </a>
            </div>
        </div>

    </div>
</div>

<script>
    function showPaymentInfo(method) {
        const paymentInfo = document.getElementById('payment-info');
        const cardInfo = document.getElementById('payment-credit-card');
        const ewalletInfo = document.getElementById('ewallet-info');

        paymentInfo.innerHTML = '';
        cardInfo.classList.add('d-none');
        ewalletInfo.classList.add('d-none');

        // Lưu phương thức thanh toán để trang ThanhToan đọc
        sessionStorage.setItem('paymentMethod', method);

        if (method === 'Card') {
            paymentInfo.innerHTML = `<p><strong>Thông tin thanh toán:</strong> Thanh toán qua thẻ ngân hàng.</p>`;
            cardInfo.classList.remove('d-none');
        } else if (method === 'Ewallet') {
            paymentInfo.innerHTML = `<p><strong>Thông tin thanh toán:</strong> Thanh toán qua ví điện tử.</p>`;
            ewalletInfo.classList.remove('d-none');
        } else {
            paymentInfo.innerHTML = `<p><strong>Thông tin thanh toán:</strong> Thanh toán khi nhận hàng.</p>`;
        }
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
