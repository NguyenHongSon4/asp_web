@model EditUserViewModel

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .um-create-wrap {
        font-family: 'Be Vietnam Pro', sans-serif;
        max-width: 580px;
        margin: 0 auto;
        padding-bottom: 60px;
    }

    /* ── Header ── */
    .um-create-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

        .um-create-header .icon-wrap {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 19px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        }

        .um-create-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

        .um-create-header p {
            font-size: 13px;
            color: #aaa;
            margin: 2px 0 0;
        }

    /* ── Panel ── */
    .um-create-panel {
        background: #fff;
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 2px 24px rgba(0,0,0,0.07);
        border: 1.5px solid #eef0f8;
    }

    /* ── Section label ── */
    .um-section {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #bbb;
        margin: 24px 0 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .um-section i {
            color: #4361ee;
        }

        .um-section:first-child {
            margin-top: 0;
        }

    /* ── Form group ── */
    .um-form-group {
        margin-bottom: 16px;
    }

        .um-form-group label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #aaa;
            margin-bottom: 7px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .um-form-group label i {
                color: #4361ee;
                font-size: 11px;
            }

    .um-input, .um-select {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1.5px solid #eee;
        border-radius: 12px;
        font-size: 14px;
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #1a1a2e;
        outline: none;
        background: #fafbff;
        transition: border-color 0.18s, box-shadow 0.18s;
    }

        .um-input:focus, .um-select:focus {
            border-color: #4361ee;
            box-shadow: 0 0 0 3px rgba(67,97,238,0.1);
            background: #fff;
        }

        .um-input::placeholder {
            color: #ccc;
        }

    /* Password input wrap */
    .um-pwd-wrap {
        position: relative;
    }

        .um-pwd-wrap .um-input {
            padding-right: 44px;
        }

    .um-pwd-toggle {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #bbb;
        cursor: pointer;
        font-size: 14px;
        transition: color 0.18s;
    }

        .um-pwd-toggle:hover {
            color: #4361ee;
        }

    /* Role select */
    .um-role-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .um-role-option {
        position: relative;
    }

        .um-role-option input[type="radio"] {
            display: none;
        }

    .um-role-label {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 12px;
        border: 1.5px solid #eee;
        background: #fafbff;
        cursor: pointer;
        font-size: 13.5px;
        font-weight: 500;
        color: #555;
        transition: all 0.18s;
    }

        .um-role-label .role-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }

    .um-role-option.user .role-icon {
        background: #f0f2ff;
        color: #4361ee;
    }

    .um-role-option.admin .role-icon {
        background: #fff8e8;
        color: #d97706;
    }

    .um-role-option input:checked + .um-role-label {
        border-color: #4361ee;
        background: #f0f2ff;
        color: #4361ee;
        font-weight: 600;
    }

    .um-role-option.admin input:checked + .um-role-label {
        border-color: #d97706;
        background: #fffbeb;
        color: #d97706;
    }

    .um-field-error {
        font-size: 12px;
        color: #e63946;
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* ── 2 col grid ── */
    .um-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    @@media (max-width: 500px) {
        .um-row {
            grid-template-columns: 1fr;
        }
    }

    /* ── Divider ── */
    .um-divider {
        border: none;
        border-top: 1.5px solid #f0f2f8;
        margin: 24px 0;
    }

    /* ── Actions ── */
    .um-form-actions {
        display: flex;
        gap: 10px;
    }

    .btn-um-submit {
        flex: 1;
        height: 48px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        transition: opacity 0.18s, transform 0.15s;
    }

        .btn-um-submit:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .btn-um-back {
        height: 48px;
        padding: 0 20px;
        border-radius: 14px;
        border: 1.5px solid #eee;
        background: #f8f9ff;
        color: #666;
        font-size: 14px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        transition: background 0.18s, color 0.18s, border-color 0.18s;
        white-space: nowrap;
    }

        .btn-um-back:hover {
            background: #f0f2ff;
            color: #4361ee;
            border-color: #c5caff;
        }
</style>

<div class="um-create-wrap">

    <!-- Success message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background:#f0fdf4;border:1.5px solid #a7f3d0;border-radius:14px;
                        padding:13px 18px;margin-bottom:20px;
                        display:flex;align-items:center;gap:10px;font-size:13.5px;color:#10b981;
                        font-family:'Be Vietnam Pro',sans-serif;font-weight:600;">
            <i class="fas fa-check-circle" style="font-size:16px;"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- Header -->
    <div class="um-create-header">
        <div class="icon-wrap"><i class="fas fa-user-edit"></i></div>
        <div>
            <h2>Chỉnh sửa người dùng</h2>
            <p>Cập nhật thông tin tài khoản người dùng</p>
        </div>
    </div>

    <!-- Panel -->
    <div class="um-create-panel">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <!-- Thông tin tài khoản -->
            <div class="um-section"><i class="fas fa-key"></i> Thông tin tài khoản</div>

            <div class="um-form-group">
                <label><i class="fas fa-user"></i> Tên đăng nhập</label>
                <input asp-for="Username" type="text" class="um-input" placeholder="Nhập tên đăng nhập..." />
                <span asp-validation-for="Username" class="um-field-error"></span>
            </div>

            <div class="um-form-group">
                <label><i class="fas fa-envelope"></i> Email</label>
                <input asp-for="Email" type="email" class="um-input" placeholder="example@email.com" />
                <span asp-validation-for="Email" class="um-field-error"></span>
            </div>

            <!-- Thông tin cá nhân -->
            <div class="um-section"><i class="fas fa-id-card"></i> Thông tin cá nhân</div>

            <div class="um-row">
                <div class="um-form-group">
                    <label><i class="fas fa-user-circle"></i> Họ tên</label>
                    <input asp-for="Name" type="text" class="um-input" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="Name" class="um-field-error"></span>
                </div>
                <div class="um-form-group">
                    <label><i class="fas fa-map-marker-alt"></i> Địa chỉ</label>
                    <input asp-for="Address" type="text" class="um-input" placeholder="Số nhà, đường..." />
                    <span asp-validation-for="Address" class="um-field-error"></span>
                </div>
            </div>

            <hr class="um-divider">

            <!-- Actions -->
            <div class="um-form-actions">
                <a asp-action="Index" class="btn-um-back">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
                <button type="submit" class="btn-um-submit">
                    <i class="fas fa-save"></i> Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    @* Giữ nguyên logic redirect sau submit *@
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector("form");
        form.addEventListener("submit", function () {
            setTimeout(function () {
                window.location.href = "@Url.Action("Index", "UserManager", new { area = "Admin" })";
            }, 500);
        });
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
