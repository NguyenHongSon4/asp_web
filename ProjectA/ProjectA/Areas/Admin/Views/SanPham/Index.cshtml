@model IEnumerable<SanPham>

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .sp-wrap {
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #1a1a2e;
    }

    /* ── Header ── */
    .sp-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .sp-title {
        font-size: 22px;
        font-weight: 700;
        color: #1a1a2e;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
    }

        .sp-title .icon-wrap {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 17px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        }

    .sp-count-badge {
        background: #f0f2ff;
        color: #4361ee;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 14px;
        border-radius: 20px;
        border: 1.5px solid #c5caff;
    }

    .btn-sp-add {
        height: 40px;
        padding: 0 18px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
        font-size: 13.5px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        display: flex;
        align-items: center;
        gap: 7px;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 3px 10px rgba(16,185,129,0.28);
        transition: opacity 0.18s, transform 0.15s;
        white-space: nowrap;
    }

        .btn-sp-add:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── Panel & Table ── */
    .sp-panel {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 2px 20px rgba(0,0,0,0.06);
        border: 1.5px solid #eef0f8;
        overflow: hidden;
    }

    .sp-table {
        width: 100%;
        border-collapse: collapse;
    }

        .sp-table thead tr {
            background: #f8f9ff;
            border-bottom: 2px solid #eef0f8;
        }

        .sp-table thead th {
            padding: 14px 16px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #aaa;
            text-align: left;
            white-space: nowrap;
        }

            .sp-table thead th i {
                color: #4361ee;
                margin-right: 5px;
            }

        .sp-table tbody tr {
            border-bottom: 1px solid #f5f5f8;
            transition: background 0.15s;
        }

            .sp-table tbody tr:last-child {
                border-bottom: none;
            }

            .sp-table tbody tr:hover {
                background: #fafbff;
            }

        .sp-table td {
            padding: 13px 16px;
            font-size: 13.5px;
            color: #444;
            vertical-align: middle;
        }

    /* Product cell */
    .sp-product-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .sp-img {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        object-fit: contain;
        background: #f5f5f8;
        border: 1.5px solid #eef0f8;
        flex-shrink: 0;
        padding: 4px;
    }

    .sp-name {
        font-weight: 600;
        color: #1a1a2e;
        font-size: 13.5px;
    }

    .sp-desc {
        font-size: 11.5px;
        color: #aaa;
        margin-top: 2px;
        max-width: 180px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Price */
    .sp-price {
        font-size: 14px;
        font-weight: 700;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        white-space: nowrap;
    }

    /* Category chip */
    .sp-category {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 20px;
        background: #f0f2ff;
        color: #4361ee;
        font-size: 12px;
        font-weight: 600;
        border: 1.5px solid #c5caff;
        white-space: nowrap;
    }

        .sp-category i {
            font-size: 10px;
        }

    /* Actions */
    .sp-actions {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .btn-sp-edit, .btn-sp-detail, .btn-sp-del {
        height: 32px;
        padding: 0 10px;
        border-radius: 9px;
        border: none;
        font-size: 12px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
        transition: background 0.18s, color 0.18s;
        white-space: nowrap;
    }

    .btn-sp-edit {
        background: #fff8e8;
        color: #d97706;
        border: 1.5px solid #fde68a;
    }

        .btn-sp-edit:hover {
            background: #d97706;
            color: #fff;
            border-color: #d97706;
        }

    .btn-sp-detail {
        background: #f0f2ff;
        color: #4361ee;
        border: 1.5px solid #c5caff;
    }

        .btn-sp-detail:hover {
            background: #4361ee;
            color: #fff;
            border-color: #4361ee;
        }

    .btn-sp-del {
        width: 32px;
        padding: 0;
        background: #fff0f1;
        color: #e63946;
        border: 1.5px solid #ffc5c8;
        justify-content: center;
    }

        .btn-sp-del:hover {
            background: #e63946;
            color: #fff;
            border-color: #e63946;
        }

    /* Empty */
    .sp-empty {
        text-align: center;
        padding: 60px 20px;
        color: #ccc;
    }

        .sp-empty i {
            font-size: 40px;
            display: block;
            margin-bottom: 12px;
        }

    /* Toast */
    .sp-toast {
        position: fixed;
        bottom: 80px;
        right: 24px;
        background: #1a1a2e;
        color: #fff;
        padding: 12px 20px;
        border-radius: 14px;
        font-size: 13.5px;
        font-family: 'Be Vietnam Pro', sans-serif;
        display: none;
        align-items: center;
        gap: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
        z-index: 9999;
    }

        .sp-toast.show {
            display: flex;
        }

        .sp-toast i {
            color: #10b981;
            font-size: 16px;
        }

    @@media (max-width: 768px) {
        .sp-desc {
            display: none;
        }

        .sp-table td, .sp-table th {
            padding: 10px 10px;
        }
    }
</style>

<!-- Toast -->
<div class="sp-toast" id="spToast">
    <i class="fas fa-check-circle"></i>
    <span id="spToastMsg">Đã xóa sản phẩm!</span>
</div>

<div class="sp-wrap">

    <!-- Header -->
    <div class="sp-header">
        <h2 class="sp-title">
            <span class="icon-wrap"><i class="fas fa-cube"></i></span>
            Quản lý sản phẩm
        </h2>
        <div style="display:flex;align-items:center;gap:10px;">
            <span class="sp-count-badge">@Model.Count() sản phẩm</span>
            <a asp-controller="SanPham" asp-action="Upsert" class="btn-sp-add">
                <i class="fas fa-plus"></i> Thêm sản phẩm
            </a>
        </div>
    </div>

    <!-- Table -->
    <div class="sp-panel">
        <table class="sp-table">
            <thead>
                <tr>
                    <th><i class="fas fa-box"></i> Sản phẩm</th>
                    <th><i class="fas fa-money-bill-wave"></i> Giá</th>
                    <th><i class="fas fa-tags"></i> Thể loại</th>
                    <th><i class="fas fa-cog"></i> Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4">
                            <div class="sp-empty">
                                <i class="fas fa-box-open"></i>
                                <p>Chưa có sản phẩm nào</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.Id">
                            <td>
                                <div class="sp-product-cell">
                                    <img src="@item.ImageUrl" class="sp-img" alt="@item.Name" />
                                    <div>
                                        <div class="sp-name">@item.Name</div>
                                        <div class="sp-desc">@item.Description</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="sp-price">@item.price.ToString("N0").Replace("'", ".")đ</span>
                            </td>
                            <td>
                                <span class="sp-category">
                                    <i class="fas fa-folder"></i> @item.TheLoai.Name
                                </span>
                            </td>
                            <td>
                                <div class="sp-actions">
                                    <a asp-action="Upsert" asp-route-id="@item.Id" class="btn-sp-edit">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-sp-detail">
                                        <i class="fas fa-eye"></i> Chi tiết
                                    </a>
                                    <button class="btn-sp-del" title="Xóa sản phẩm"
                                            onclick="confirmDelete(@item.Id, this)">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>

<script>
    function showToast(msg, success) {
        var t = document.getElementById('spToast');
        document.getElementById('spToastMsg').textContent = msg;
        t.querySelector('i').style.color = success ? '#10b981' : '#e63946';
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2500);
    }

    function confirmDelete(id, btn) {
        if (confirm('Bạn có chắc chắn muốn xóa sản phẩm này?')) {
            xoa(id, btn);
        }
    }

    function xoa(idx, btn) {
        // Disable nút tránh double click
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        $.ajax({
            url: 'SanPham/Delete',
            type: 'POST',
            data: { id: idx },
            success: function (data) {
                if (data.success) {
                    var row = document.getElementById('row-' + idx);
                    if (row) {
                        row.style.transition = 'opacity 0.3s';
                        row.style.opacity = '0';
                        setTimeout(() => row.remove(), 320);
                    }
                    showToast('Đã xóa sản phẩm thành công!', true);
                } else {
                    showToast(data.message || 'Xóa thất bại!', false);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-trash-alt"></i>';
                }
            },
            error: function () {
                showToast('Có lỗi xảy ra, vui lòng thử lại.', false);
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-trash-alt"></i>';
            }
        });
    }
</script>
