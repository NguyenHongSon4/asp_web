@{
    ViewData["Title"] = Model.Id == 0 ? "Tạo sản phẩm" : "Cập nhật sản phẩm";
}
@model SanPham

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .sp-upsert-wrap {
        font-family: 'Be Vietnam Pro', sans-serif;
        max-width: 680px;
        margin: 0 auto;
        padding-bottom: 60px;
    }

    /* ── Header ── */
    .sp-upsert-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

        .sp-upsert-header .icon-wrap {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 19px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        }

        .sp-upsert-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

        .sp-upsert-header p {
            font-size: 13px;
            color: #aaa;
            margin: 2px 0 0;
        }

    /* ── Panel ── */
    .sp-upsert-panel {
        background: #fff;
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 2px 24px rgba(0,0,0,0.07);
        border: 1.5px solid #eef0f8;
    }

    /* ── Section label ── */
    .sp-section {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #bbb;
        margin: 24px 0 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .sp-section i {
            color: #4361ee;
        }

        .sp-section:first-child {
            margin-top: 0;
        }

    /* ── Form group ── */
    .sp-form-group {
        margin-bottom: 18px;
    }

        .sp-form-group label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #aaa;
            margin-bottom: 7px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .sp-form-group label i {
                color: #4361ee;
                font-size: 11px;
            }

    .sp-input, .sp-select, .sp-textarea {
        width: 100%;
        padding: 11px 16px;
        border: 1.5px solid #eee;
        border-radius: 12px;
        font-size: 14px;
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #1a1a2e;
        outline: none;
        background: #fafbff;
        transition: border-color 0.18s, box-shadow 0.18s;
    }

        .sp-input:focus, .sp-select:focus, .sp-textarea:focus {
            border-color: #4361ee;
            box-shadow: 0 0 0 3px rgba(67,97,238,0.1);
            background: #fff;
        }

        .sp-input::placeholder, .sp-textarea::placeholder {
            color: #ccc;
        }

    .sp-textarea {
        resize: vertical;
        min-height: 90px;
        line-height: 1.6;
    }

    .sp-select {
        height: 46px;
        cursor: pointer;
    }

    /* Price input with đ suffix */
    .sp-price-wrap {
        position: relative;
    }

        .sp-price-wrap .sp-input {
            padding-right: 40px;
        }

    .sp-price-suffix {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 14px;
        font-weight: 700;
        color: #4361ee;
        pointer-events: none;
    }

    /* Image preview */
    .sp-img-preview-wrap {
        margin-top: 10px;
        display: none;
        background: #f8f9ff;
        border-radius: 12px;
        padding: 10px;
        border: 1.5px dashed #c5caff;
        text-align: center;
    }

        .sp-img-preview-wrap img {
            max-height: 140px;
            object-fit: contain;
            border-radius: 8px;
        }

        .sp-img-preview-wrap p {
            font-size: 11.5px;
            color: #aaa;
            margin: 6px 0 0;
        }

    .sp-field-error {
        font-size: 12px;
        color: #e63946;
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* ── 2 col ── */
    .sp-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    @@media (max-width: 540px) {
        .sp-row {
            grid-template-columns: 1fr;
        }
    }

    /* ── Divider ── */
    .sp-divider {
        border: none;
        border-top: 1.5px solid #f0f2f8;
        margin: 24px 0;
    }

    /* ── Actions ── */
    .sp-form-actions {
        display: flex;
        gap: 10px;
    }

    .btn-sp-submit {
        flex: 1;
        height: 48px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        transition: opacity 0.18s, transform 0.15s;
    }

        .btn-sp-submit:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .btn-sp-cancel {
        height: 48px;
        padding: 0 20px;
        border-radius: 14px;
        border: 1.5px solid #eee;
        background: #f8f9ff;
        color: #666;
        font-size: 14px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        transition: background 0.18s, color 0.18s, border-color 0.18s;
        white-space: nowrap;
    }

        .btn-sp-cancel:hover {
            background: #f0f2ff;
            color: #4361ee;
            border-color: #c5caff;
        }
</style>

<div class="sp-upsert-wrap">

    <!-- Header -->
    <div class="sp-upsert-header">
        <div class="icon-wrap">
            <i class="fas @(Model.Id == 0 ? "fa-plus" : "fa-edit")"></i>
        </div>
        <div>
            <h2>@(Model.Id == 0 ? "Thêm sản phẩm mới" : "Cập nhật sản phẩm")</h2>
            <p>@(Model.Id == 0 ? "Điền thông tin để tạo sản phẩm mới" : $"Đang chỉnh sửa sản phẩm #{Model.Id}")</p>
        </div>
    </div>

    <!-- Panel -->
    <div class="sp-upsert-panel">
        <form method="post" asp-action="Upsert">
            @Html.AntiForgeryToken()

            <!-- Thông tin cơ bản -->
            <div class="sp-section"><i class="fas fa-box"></i> Thông tin sản phẩm</div>

            <div class="sp-form-group">
                <label><i class="fas fa-box"></i> Tên sản phẩm</label>
                <input asp-for="Name" type="text" class="sp-input" placeholder="Nhập tên sản phẩm..." />
                <span asp-validation-for="Name" class="sp-field-error"></span>
            </div>

            <div class="sp-row">
                <div class="sp-form-group">
                    <label><i class="fas fa-tags"></i> Thể loại</label>
                    <select asp-for="TheLoaiId" asp-items="@ViewBag.DSTheLoai" class="sp-select">
                        <option value="" disabled>-- Chọn thể loại --</option>
                    </select>
                    <span asp-validation-for="TheLoaiId" class="sp-field-error"></span>
                </div>
                <div class="sp-form-group">
                    <label><i class="fas fa-money-bill-wave"></i> Giá bán</label>
                    <div class="sp-price-wrap">
                        <input asp-for="price" type="number" class="sp-input" placeholder="0" min="0" />
                        <span class="sp-price-suffix">đ</span>
                    </div>
                    <span asp-validation-for="price" class="sp-field-error"></span>
                </div>
            </div>

            <div class="sp-form-group">
                <label><i class="fas fa-align-left"></i> Mô tả sản phẩm</label>
                <textarea asp-for="Description" class="sp-textarea" placeholder="Nhập mô tả chi tiết về sản phẩm..."></textarea>
                <span asp-validation-for="Description" class="sp-field-error"></span>
            </div>

            <!-- Hình ảnh -->
            <div class="sp-section"><i class="fas fa-image"></i> Hình ảnh</div>

            <div class="sp-form-group">
                <label><i class="fas fa-link"></i> URL hình ảnh</label>
                <input asp-for="ImageUrl" type="text" class="sp-input"
                       placeholder="https://example.com/image.jpg"
                       oninput="previewImg(this.value)" />
                <span asp-validation-for="ImageUrl" class="sp-field-error"></span>

                <!-- Preview ảnh -->
                <div class="sp-img-preview-wrap" id="imgPreview">
                    <img id="imgPreviewEl" src="" alt="Preview">
                    <p>Xem trước hình ảnh</p>
                </div>
            </div>

            <hr class="sp-divider">

            <!-- Actions -->
            <div class="sp-form-actions">
                <a asp-action="Index" class="btn-sp-cancel">
                    <i class="fas fa-times"></i> Hủy
                </a>
                <button type="submit" class="btn-sp-submit">
                    <i class="fas @(Model.Id == 0 ? "fa-plus-circle" : "fa-save")"></i>
                    @(Model.Id == 0 ? "Tạo sản phẩm" : "Lưu thay đổi")
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // Preview ảnh khi nhập URL
    function previewImg(url) {
        var wrap = document.getElementById('imgPreview');
        var img  = document.getElementById('imgPreviewEl');
        if (url && url.trim() !== '') {
            img.src = url;
            img.onload  = function() { wrap.style.display = 'block'; };
            img.onerror = function() { wrap.style.display = 'none'; };
        } else {
            wrap.style.display = 'none';
        }
    }

    // Nếu đang edit, show preview ảnh hiện tại
    window.addEventListener('DOMContentLoaded', function() {
        var url = document.querySelector('[name="ImageUrl"]')?.value;
        if (url) previewImg(url);
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
