@model SanPham

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .sp-detail-wrap {
        font-family: 'Be Vietnam Pro', sans-serif;
        max-width: 780px;
        margin: 0 auto;
        padding-bottom: 60px;
    }

    /* ── Header ── */
    .sp-detail-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .sp-detail-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .sp-detail-title .icon-wrap {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 18px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        }

        .sp-detail-title h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

        .sp-detail-title p {
            font-size: 13px;
            color: #aaa;
            margin: 2px 0 0;
        }

    .btn-sp-back {
        height: 40px;
        padding: 0 18px;
        border-radius: 12px;
        border: 1.5px solid #eee;
        background: #f8f9ff;
        color: #555;
        font-size: 13px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        display: flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: background 0.18s, color 0.18s, border-color 0.18s;
        white-space: nowrap;
    }

        .btn-sp-back:hover {
            background: #f0f2ff;
            color: #4361ee;
            border-color: #c5caff;
        }

    /* ── Layout ── */
    .sp-detail-grid {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 20px;
        align-items: start;
    }

    @@media (max-width: 640px) {
        .sp-detail-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ── Image panel ── */
    .sp-img-panel {
        background: #fff;
        border-radius: 20px;
        padding: 20px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        border: 1.5px solid #eef0f8;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
    }

    .sp-img-main {
        width: 100%;
        aspect-ratio: 1;
        object-fit: contain;
        border-radius: 14px;
        background: #f8f9ff;
        padding: 12px;
    }

    .sp-category-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 20px;
        background: #f0f2ff;
        color: #4361ee;
        font-size: 12.5px;
        font-weight: 600;
        border: 1.5px solid #c5caff;
    }

    /* ── Info panel ── */
    .sp-info-panel {
        background: #fff;
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        border: 1.5px solid #eef0f8;
    }

    .sp-product-name {
        font-size: 20px;
        font-weight: 800;
        color: #1a1a2e;
        margin-bottom: 6px;
        line-height: 1.3;
    }

    .sp-product-price {
        font-size: 26px;
        font-weight: 800;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 20px;
    }

    .sp-info-divider {
        border: none;
        border-top: 1.5px solid #f0f2f8;
        margin: 18px 0;
    }

    .sp-info-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid #f5f5f8;
    }

        .sp-info-row:last-child {
            border-bottom: none;
        }

    .sp-info-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #f0f2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4361ee;
        font-size: 13px;
        flex-shrink: 0;
    }

    .sp-info-key {
        font-size: 11px;
        color: #bbb;
        margin-bottom: 2px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .sp-info-val {
        font-size: 13.5px;
        font-weight: 600;
        color: #1a1a2e;
    }

        .sp-info-val.desc {
            font-weight: 400;
            color: #666;
            line-height: 1.7;
        }

    /* ── Actions ── */
    .sp-detail-actions {
        display: flex;
        gap: 10px;
        margin-top: 24px;
    }

    .btn-sp-edit-go {
        flex: 1;
        height: 46px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        font-family: 'Be Vietnam Pro', sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        transition: opacity 0.18s, transform 0.15s;
    }

        .btn-sp-edit-go:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            color: #fff;
        }
</style>

<div class="sp-detail-wrap">

    <!-- Header -->
    <div class="sp-detail-header">
        <div class="sp-detail-title">
            <div class="icon-wrap"><i class="fas fa-cube"></i></div>
            <div>
                <h2>Chi tiết sản phẩm</h2>
                <p>Thông tin đầy đủ của sản phẩm</p>
            </div>
        </div>
        <a asp-action="Index" class="btn-sp-back">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <!-- Grid -->
    <div class="sp-detail-grid">

        <!-- Ảnh -->
        <div class="sp-img-panel">
            <img src="@Model.ImageUrl" class="sp-img-main" alt="@Model.Name" />
            <span class="sp-category-chip">
                <i class="fas fa-folder"></i> @Model.TheLoai?.Name
            </span>
        </div>

        <!-- Thông tin -->
        <div class="sp-info-panel">
            <div class="sp-product-name">@Model.Name</div>
            <div class="sp-product-price">@Model.price.ToString("N0").Replace("'", ".")đ</div>

            <hr class="sp-info-divider">

            <div class="sp-info-row">
                <div class="sp-info-icon"><i class="fas fa-hashtag"></i></div>
                <div>
                    <div class="sp-info-key">Mã sản phẩm</div>
                    <div class="sp-info-val" style="color:#4361ee;">#@Model.Id</div>
                </div>
            </div>

            <div class="sp-info-row">
                <div class="sp-info-icon"><i class="fas fa-align-left"></i></div>
                <div>
                    <div class="sp-info-key">Mô tả</div>
                    <div class="sp-info-val desc">@(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả" : Model.Description)</div>
                </div>
            </div>

            <div class="sp-info-row">
                <div class="sp-info-icon"><i class="fas fa-tags"></i></div>
                <div>
                    <div class="sp-info-key">Thể loại</div>
                    <div class="sp-info-val">@Model.TheLoai?.Name</div>
                </div>
            </div>

            <div class="sp-info-row">
                <div class="sp-info-icon"><i class="fas fa-money-bill-wave"></i></div>
                <div>
                    <div class="sp-info-key">Giá bán</div>
                    <div class="sp-info-val">@Model.price.ToString("N0").Replace("'", ".")đ</div>
                </div>
            </div>

            <!-- Actions -->
            <div class="sp-detail-actions">
                <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn-sp-edit-go">
                    <i class="fas fa-edit"></i> Chỉnh sửa sản phẩm này
                </a>
            </div>
        </div>
    </div>

</div>
