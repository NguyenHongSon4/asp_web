@model HoaDonViewModel

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .dh-detail-wrap {
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #1a1a2e;
        max-width: 860px;
        margin: 0 auto;
        padding-bottom: 60px;
    }

    /* ── Header ── */
    .dh-detail-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 28px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .dh-detail-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .dh-detail-title .icon-wrap {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 18px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        }

        .dh-detail-title h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

        .dh-detail-title p {
            font-size: 13px;
            color: #aaa;
            margin: 2px 0 0;
        }

    .btn-dh-back {
        height: 40px;
        padding: 0 18px;
        border-radius: 12px;
        border: 1.5px solid #eee;
        background: #f8f9ff;
        color: #555;
        font-size: 13px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        display: flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: background 0.18s, color 0.18s, border-color 0.18s;
        white-space: nowrap;
    }

        .btn-dh-back:hover {
            background: #f0f2ff;
            color: #4361ee;
            border-color: #c5caff;
        }

    /* ── 2 col layout ── */
    .dh-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
    }

    @@media (max-width: 640px) {
        .dh-detail-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ── Info panel ── */
    .dh-info-panel {
        background: #fff;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        border: 1.5px solid #eef0f8;
    }

    .dh-panel-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #bbb;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .dh-panel-label i {
            color: #4361ee;
        }

    .dh-info-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 11px 0;
        border-bottom: 1px solid #f5f5f8;
    }

        .dh-info-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .dh-info-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: #f0f2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4361ee;
        font-size: 13px;
        flex-shrink: 0;
        margin-top: 1px;
    }

    .dh-info-key {
        font-size: 11.5px;
        color: #bbb;
        margin-bottom: 2px;
    }

    .dh-info-val {
        font-size: 14px;
        font-weight: 600;
        color: #1a1a2e;
    }

    /* Status badge */
    .dh-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12.5px;
        font-weight: 600;
    }

        .dh-status-badge.pending {
            background: #fffbeb;
            color: #d97706;
            border: 1.5px solid #fde68a;
        }

        .dh-status-badge.done {
            background: #f0fdf4;
            color: #10b981;
            border: 1.5px solid #a7f3d0;
        }

        .dh-status-badge.shipping {
            background: #f0f2ff;
            color: #4361ee;
            border: 1.5px solid #c5caff;
        }

        .dh-status-badge.cancel {
            background: #fff0f1;
            color: #e63946;
            border: 1.5px solid #ffc5c8;
        }

        .dh-status-badge.default {
            background: #f5f5f8;
            color: #888;
            border: 1.5px solid #e0e3f0;
        }

    /* ── Products table panel ── */
    .dh-table-panel {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        border: 1.5px solid #eef0f8;
        overflow: hidden;
        margin-bottom: 16px;
    }

    .dh-table-header {
        padding: 18px 22px 14px;
        border-bottom: 1.5px solid #f0f2f8;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #bbb;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .dh-table-header i {
            color: #4361ee;
        }

    .dh-prod-table {
        width: 100%;
        border-collapse: collapse;
    }

        .dh-prod-table thead tr {
            background: #f8f9ff;
        }

        .dh-prod-table thead th {
            padding: 12px 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #aaa;
            text-align: left;
        }

        .dh-prod-table tbody tr {
            border-bottom: 1px solid #f5f5f8;
            transition: background 0.15s;
        }

            .dh-prod-table tbody tr:last-child {
                border-bottom: none;
            }

            .dh-prod-table tbody tr:hover {
                background: #fafbff;
            }

        .dh-prod-table td {
            padding: 14px 20px;
            font-size: 13.5px;
            color: #444;
            vertical-align: middle;
        }

    .dh-prod-name {
        font-weight: 600;
        color: #1a1a2e;
    }

    .dh-qty-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: #f0f2ff;
        color: #4361ee;
        font-size: 13px;
        font-weight: 700;
        border: 1.5px solid #c5caff;
    }

    .dh-price {
        font-size: 14px;
        font-weight: 700;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* ── Total bar ── */
    .dh-total-bar {
        background: linear-gradient(135deg, #4361ee, #7209b7);
        border-radius: 16px;
        padding: 20px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 6px 20px rgba(67,97,238,0.28);
    }

        .dh-total-bar .label {
            font-size: 14px;
            font-weight: 600;
            color: rgba(255,255,255,0.8);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .dh-total-bar .amount {
            font-size: 24px;
            font-weight: 800;
            color: #fff;
            letter-spacing: -0.5px;
        }
</style>

<div class="dh-detail-wrap">

    <!-- Header -->
    <div class="dh-detail-header">
        <div class="dh-detail-title">
            <div class="icon-wrap"><i class="fas fa-file-invoice"></i></div>
            <div>
                <h2>Chi tiết đơn hàng <span style="color:#4361ee;">#@Model.HoaDon.Id</span></h2>
                <p>Xem toàn bộ thông tin và sản phẩm trong đơn hàng</p>
            </div>
        </div>
        <a asp-action="Index" class="btn-dh-back">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <!-- Info grid -->
    <div class="dh-detail-grid">

        <!-- Thông tin khách hàng -->
        <div class="dh-info-panel">
            <div class="dh-panel-label"><i class="fas fa-user"></i> Thông tin khách hàng</div>

            <div class="dh-info-row">
                <div class="dh-info-icon"><i class="fas fa-user"></i></div>
                <div>
                    <div class="dh-info-key">Họ tên</div>
                    <div class="dh-info-val">@Model.HoaDon.Name</div>
                </div>
            </div>
            <div class="dh-info-row">
                <div class="dh-info-icon"><i class="fas fa-phone"></i></div>
                <div>
                    <div class="dh-info-key">Số điện thoại</div>
                    <div class="dh-info-val">@Model.HoaDon.PhoneNumber</div>
                </div>
            </div>
            <div class="dh-info-row">
                <div class="dh-info-icon"><i class="fas fa-map-marker-alt"></i></div>
                <div>
                    <div class="dh-info-key">Địa chỉ</div>
                    <div class="dh-info-val">@Model.HoaDon.Address</div>
                </div>
            </div>
        </div>

        <!-- Thông tin đơn hàng -->
        <div class="dh-info-panel">
            <div class="dh-panel-label"><i class="fas fa-clipboard-list"></i> Thông tin đơn hàng</div>

            <div class="dh-info-row">
                <div class="dh-info-icon"><i class="fas fa-hashtag"></i></div>
                <div>
                    <div class="dh-info-key">Mã đơn hàng</div>
                    <div class="dh-info-val" style="color:#4361ee;">#@Model.HoaDon.Id</div>
                </div>
            </div>
            <div class="dh-info-row">
                <div class="dh-info-icon"><i class="fas fa-calendar-alt"></i></div>
                <div>
                    <div class="dh-info-key">Ngày đặt hàng</div>
                    <div class="dh-info-val">@Model.HoaDon.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
            <div class="dh-info-row">
                <div class="dh-info-icon"><i class="fas fa-info-circle"></i></div>
                <div>
                    <div class="dh-info-key">Trạng thái</div>
                    <div>
                        @{
                            string sc = "default";
                            if (Model.HoaDon.OrderStatus != null)
                            {
                                if (Model.HoaDon.OrderStatus.Contains("xác nhận")) sc = "pending";
                                else if (Model.HoaDon.OrderStatus.Contains("thành công") || Model.HoaDon.OrderStatus.Contains("hoàn thành")) sc = "done";
                                else if (Model.HoaDon.OrderStatus.Contains("giao") || Model.HoaDon.OrderStatus.Contains("vận chuyển")) sc = "shipping";
                                else if (Model.HoaDon.OrderStatus.Contains("hủy")) sc = "cancel";
                            }
                        }
                        <span class="dh-status-badge @sc">
                            @if (sc == "done")
                            {
                                <i class="fas fa-check-circle"></i>
                            }
                            else if (sc == "pending")
                            {

                                <i class="fas fa-clock"></i>
                            }
                            else if (sc == "shipping")
                            {

                                <i class="fas fa-truck"></i>
                            }
                            else if (sc == "cancel")
                            {

                                <i class="fas fa-times-circle"></i>
                            }
                            else
                            {

                                <i class="fas fa-circle"></i>
                            }
                            @Model.HoaDon.OrderStatus
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Products table -->
    <div class="dh-table-panel">
        <div class="dh-table-header">
            <i class="fas fa-box"></i> Sản phẩm trong đơn (@Model.ChiTietHoaDon.Count() sản phẩm)
        </div>
        <table class="dh-prod-table">
            <thead>
                <tr>
                    <th>Tên sản phẩm</th>
                    <th style="text-align:center;">Số lượng</th>
                    <th style="text-align:right;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ChiTietHoaDon)
                {
                    <tr>
                        <td><div class="dh-prod-name">@item.SanPham.Name</div></td>
                        <td style="text-align:center;">
                            <span class="dh-qty-chip">@item.Quantity</span>
                        </td>
                        <td style="text-align:right;">
                            <span class="dh-price">@item.ProductPrice.ToString("N0")đ</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Total bar -->
    <div class="dh-total-bar">
        <div class="label">
            <i class="fas fa-wallet"></i> Tổng thanh toán
        </div>
        <div class="amount">@Model.HoaDon.Total.ToString("N0")đ</div>
    </div>

</div>
