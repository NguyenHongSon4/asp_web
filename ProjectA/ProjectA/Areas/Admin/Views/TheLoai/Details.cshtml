@model TheLoai

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .tl-detail-wrap {
        font-family: 'Be Vietnam Pro', sans-serif;
        max-width: 560px;
        margin: 0 auto;
        padding-bottom: 60px;
    }

    /* ── Header ── */
    .tl-detail-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

        .tl-detail-header .icon-wrap {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 19px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        }

        .tl-detail-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

        .tl-detail-header p {
            font-size: 13px;
            color: #aaa;
            margin: 2px 0 0;
        }

    /* ── Panel ── */
    .tl-detail-panel {
        background: #fff;
        border-radius: 24px;
        padding: 32px;
        box-shadow: 0 2px 24px rgba(0,0,0,0.07);
        border: 1.5px solid #eef0f8;
    }

    /* ── Info rows ── */
    .tl-info-row {
        display: flex;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid #f5f5f8;
        gap: 16px;
    }

        .tl-info-row:last-of-type {
            border-bottom: none;
        }

    .tl-info-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: linear-gradient(135deg, #4361ee14, #7209b714);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4361ee;
        font-size: 15px;
        flex-shrink: 0;
    }

    .tl-info-label {
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #bbb;
        margin-bottom: 2px;
    }

    .tl-info-value {
        font-size: 15px;
        font-weight: 600;
        color: #1a1a2e;
    }

        .tl-info-value.id-badge {
            display: inline-flex;
            align-items: center;
            background: #f0f2ff;
            color: #4361ee;
            font-size: 13px;
            padding: 3px 12px;
            border-radius: 20px;
            border: 1.5px solid #c5caff;
            font-weight: 700;
        }

    /* ── Divider ── */
    .tl-divider {
        border: none;
        border-top: 1.5px solid #f0f2f8;
        margin: 24px 0;
    }

    /* ── Actions ── */
    .tl-detail-actions {
        display: flex;
        gap: 10px;
    }

    .btn-tl-edit-go {
        flex: 1;
        height: 48px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        transition: opacity 0.18s, transform 0.15s;
    }

        .btn-tl-edit-go:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            color: #fff;
        }

    .btn-tl-back {
        height: 48px;
        padding: 0 20px;
        border-radius: 14px;
        border: 1.5px solid #eee;
        background: #f8f9ff;
        color: #666;
        font-size: 14px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        transition: background 0.18s, color 0.18s, border-color 0.18s;
        white-space: nowrap;
    }

        .btn-tl-back:hover {
            background: #f0f2ff;
            color: #4361ee;
            border-color: #c5caff;
        }
</style>

<div class="tl-detail-wrap">

    <!-- Header -->
    <div class="tl-detail-header">
        <div class="icon-wrap"><i class="fas fa-info-circle"></i></div>
        <div>
            <h2>Chi tiết thể loại</h2>
            <p>Thông tin đầy đủ của thể loại sản phẩm</p>
        </div>
    </div>

    <!-- Panel -->
    <div class="tl-detail-panel">

        <!-- ID -->
        <div class="tl-info-row">
            <div class="tl-info-icon"><i class="fas fa-hashtag"></i></div>
            <div>
                <div class="tl-info-label">Mã thể loại</div>
                <span class="tl-info-value id-badge">#@Model.Id</span>
            </div>
        </div>

        <!-- Tên thể loại -->
        <div class="tl-info-row">
            <div class="tl-info-icon"><i class="fas fa-tag"></i></div>
            <div>
                <div class="tl-info-label">Tên thể loại</div>
                <div class="tl-info-value">@Model.Name</div>
            </div>
        </div>

        <!-- Ngày tạo -->
        <div class="tl-info-row">
            <div class="tl-info-icon"><i class="fas fa-calendar-alt"></i></div>
            <div>
                <div class="tl-info-label">Ngày tạo</div>
                <div class="tl-info-value">@String.Format("{0:dd/MM/yyyy}", Model.DateCreated)</div>
            </div>
        </div>

        <hr class="tl-divider">

        <!-- Actions -->
        <div class="tl-detail-actions">
            <a asp-action="Index" class="btn-tl-back">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-tl-edit-go">
                <i class="fas fa-edit"></i> Chỉnh sửa thể loại này
            </a>
        </div>

    </div>
</div>
