@{
    ViewData["Title"] = "Quản lý danh mục";
}

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .tl-wrap {
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #1a1a2e;
        max-width: 960px;
        margin: 0 auto;
    }

    /* ── Header ── */
    .tl-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .tl-title {
        font-size: 22px;
        font-weight: 700;
        color: #1a1a2e;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
    }

        .tl-title .icon-wrap {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 17px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        }

    /* ── Search + Add bar ── */
    .tl-toolbar {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .tl-search-wrap {
        position: relative;
        flex: 1;
        min-width: 200px;
    }

        .tl-search-wrap i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #bbb;
            font-size: 13px;
            pointer-events: none;
        }

    .tl-search-input {
        width: 100%;
        height: 42px;
        padding: 0 14px 0 38px;
        border: 1.5px solid #eee;
        border-radius: 12px;
        font-size: 13.5px;
        font-family: 'Be Vietnam Pro', sans-serif;
        outline: none;
        background: #fff;
        color: #333;
        transition: border-color 0.18s, box-shadow 0.18s;
    }

        .tl-search-input:focus {
            border-color: #4361ee;
            box-shadow: 0 0 0 3px rgba(67,97,238,0.1);
        }

        .tl-search-input::placeholder {
            color: #ccc;
        }

    .btn-tl-search {
        height: 42px;
        padding: 0 20px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 13.5px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
        box-shadow: 0 3px 10px rgba(67,97,238,0.25);
        transition: opacity 0.18s, transform 0.15s;
    }

        .btn-tl-search:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .btn-tl-add {
        height: 42px;
        padding: 0 20px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
        font-size: 13.5px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
        text-decoration: none;
        box-shadow: 0 3px 10px rgba(16,185,129,0.28);
        transition: opacity 0.18s, transform 0.15s;
    }

        .btn-tl-add:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            color: #fff;
        }

    /* ── Table panel ── */
    .tl-panel {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 2px 20px rgba(0,0,0,0.06);
        border: 1.5px solid #eef0f8;
        overflow: hidden;
    }

    .tl-table {
        width: 100%;
        border-collapse: collapse;
    }

        .tl-table thead tr {
            background: #f8f9ff;
            border-bottom: 2px solid #eef0f8;
        }

        .tl-table thead th {
            padding: 14px 20px;
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #aaa;
            text-align: left;
            white-space: nowrap;
        }

            .tl-table thead th i {
                color: #4361ee;
                margin-right: 6px;
            }

        .tl-table tbody tr {
            border-bottom: 1px solid #f5f5f8;
            transition: background 0.15s;
        }

            .tl-table tbody tr:last-child {
                border-bottom: none;
            }

            .tl-table tbody tr:hover {
                background: #fafbff;
            }

        .tl-table td {
            padding: 14px 20px;
            font-size: 13.5px;
            color: #444;
            vertical-align: middle;
        }

    /* Name cell */
    .tl-name {
        font-weight: 600;
        color: #1a1a2e;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .tl-name-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, #4361ee18, #7209b718);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4361ee;
        font-size: 14px;
        flex-shrink: 0;
    }

    /* Date cell */
    .tl-date {
        color: #888;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .tl-date i {
            color: #c5caff;
            font-size: 12px;
        }

    /* Actions */
    .tl-actions {
        display: flex;
        gap: 6px;
        align-items: center;
    }

    .btn-tl-edit, .btn-tl-detail, .btn-tl-del {
        height: 34px;
        padding: 0 12px;
        border-radius: 10px;
        border: none;
        font-size: 12.5px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
        transition: opacity 0.18s, transform 0.15s;
        white-space: nowrap;
    }

    .btn-tl-edit {
        background: #fff8e8;
        color: #d97706;
        border: 1.5px solid #fde68a;
    }

        .btn-tl-edit:hover {
            background: #d97706;
            color: #fff;
            border-color: #d97706;
        }

    .btn-tl-detail {
        background: #f0f2ff;
        color: #4361ee;
        border: 1.5px solid #c5caff;
    }

        .btn-tl-detail:hover {
            background: #4361ee;
            color: #fff;
            border-color: #4361ee;
        }

    .btn-tl-del {
        background: #fff0f1;
        color: #e63946;
        border: 1.5px solid #ffc5c8;
    }

        .btn-tl-del:hover {
            background: #e63946;
            color: #fff;
            border-color: #e63946;
        }

    /* Empty state */
    .tl-empty {
        text-align: center;
        padding: 60px 20px;
        color: #ccc;
    }

        .tl-empty i {
            font-size: 40px;
            display: block;
            margin-bottom: 12px;
        }

        .tl-empty p {
            font-size: 14px;
            color: #bbb;
        }

    /* Row count badge */
    .tl-count {
        font-size: 12px;
        color: #aaa;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .tl-count strong {
            color: #4361ee;
        }

    @@media (max-width: 600px) {
        .tl-toolbar {
            flex-direction: column;
        }

        .btn-tl-add {
            justify-content: center;
        }

        .tl-actions {
            flex-wrap: wrap;
        }
    }
</style>

<div class="tl-wrap">

    <!-- Header -->
    <div class="tl-header">
        <h2 class="tl-title">
            <span class="icon-wrap"><i class="fas fa-folder-open"></i></span>
            Quản lý danh mục
        </h2>
    </div>

    <!-- Toolbar: Search + Add -->
    <form asp-action="Search" method="get">
        <div class="tl-toolbar">
            <div class="tl-search-wrap">
                <i class="fas fa-search"></i>
                <input type="text" name="searchString" class="tl-search-input"
                       placeholder="Tìm thể loại..." value="@ViewBag.SearchString" />
            </div>
            <button type="submit" class="btn-tl-search">
                <i class="fas fa-search"></i> Tìm kiếm
            </button>
            <a asp-controller="TheLoai" asp-action="Create" class="btn-tl-add">
                <i class="fas fa-plus"></i> Thêm mới
            </a>
        </div>
    </form>

    <!-- Count -->
    @{
        var items = ViewBag.TheLoai as IEnumerable<dynamic>;
        int count = items?.Count() ?? 0;
    }
    <div class="tl-count">
        <i class="fas fa-layer-group" style="color:#4361ee;"></i>
        Tổng cộng <strong>@count</strong> danh mục
        @if (!string.IsNullOrEmpty(ViewBag.SearchString as string))
        {
            <span>— Kết quả tìm kiếm cho <strong style="color:#7209b7;">"@ViewBag.SearchString"</strong></span>
        }
    </div>

    <!-- Table -->
    <div class="tl-panel">
        <table class="tl-table">
            <thead>
                <tr>
                    <th><i class="fas fa-folder"></i> Tên danh mục</th>
                    <th><i class="fas fa-calendar-alt"></i> Ngày tạo</th>
                    <th><i class="fas fa-cog"></i> Chức năng</th>
                </tr>
            </thead>
            <tbody>
                @if (count == 0)
                {
                    <tr>
                        <td colspan="3">
                            <div class="tl-empty">
                                <i class="fas fa-folder-open"></i>
                                <p>Chưa có danh mục nào. Hãy thêm mới!</p>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in ViewBag.TheLoai)
                    {
                        <tr>
                            <td>
                                <div class="tl-name">
                                    <div class="tl-name-icon"><i class="fas fa-tag"></i></div>
                                    @item.Name
                                </div>
                            </td>
                            <td>
                                <div class="tl-date">
                                    <i class="fas fa-calendar"></i>
                                    @String.Format("{0:dd/MM/yyyy}", item.DateCreated)
                                </div>
                            </td>
                            <td>
                                <div class="tl-actions">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-tl-edit">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-tl-detail">
                                        <i class="fas fa-eye"></i> Chi tiết
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-tl-del"
                                       onclick="return confirm('Bạn có chắc muốn xóa thể loại này?');">
                                        <i class="fas fa-trash-alt"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
