@model TheLoai

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .tl-create-wrap {
        font-family: 'Be Vietnam Pro', sans-serif;
        max-width: 560px;
        margin: 0 auto;
        padding-bottom: 60px;
    }

    /* ── Header ── */
    .tl-create-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

        .tl-create-header .icon-wrap {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #4361ee, #7209b7);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 19px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        }

        .tl-create-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

        .tl-create-header p {
            font-size: 13px;
            color: #aaa;
            margin: 2px 0 0;
        }

    /* ── Panel ── */
    .tl-create-panel {
        background: #fff;
        border-radius: 24px;
        padding: 36px 32px;
        box-shadow: 0 2px 24px rgba(0,0,0,0.07);
        border: 1.5px solid #eef0f8;
    }

    /* ── Validation ── */
    .tl-validation {
        background: #fff0f1;
        border: 1.5px solid #ffc5c8;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 13px;
        color: #e63946;
        margin-bottom: 20px;
    }

    /* ── Form group ── */
    .tl-form-group {
        margin-bottom: 20px;
    }

        .tl-form-group label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #aaa;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .tl-form-group label i {
                color: #4361ee;
                font-size: 12px;
            }

    .tl-input {
        width: 100%;
        height: 46px;
        padding: 0 16px;
        border: 1.5px solid #eee;
        border-radius: 12px;
        font-size: 14px;
        font-family: 'Be Vietnam Pro', sans-serif;
        color: #1a1a2e;
        outline: none;
        background: #fafbff;
        transition: border-color 0.18s, box-shadow 0.18s;
    }

        .tl-input:focus {
            border-color: #4361ee;
            box-shadow: 0 0 0 3px rgba(67,97,238,0.1);
            background: #fff;
        }

        .tl-input::placeholder {
            color: #ccc;
        }

    .tl-field-error {
        font-size: 12px;
        color: #e63946;
        margin-top: 5px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* ── Divider ── */
    .tl-divider {
        border: none;
        border-top: 1.5px solid #f0f2f8;
        margin: 24px 0;
    }

    /* ── Actions ── */
    .tl-form-actions {
        display: flex;
        gap: 10px;
    }

    .btn-tl-submit {
        flex: 1;
        height: 48px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #4361ee, #7209b7);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(67,97,238,0.3);
        transition: opacity 0.18s, transform 0.15s;
        letter-spacing: 0.02em;
    }

        .btn-tl-submit:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    .btn-tl-back {
        height: 48px;
        padding: 0 20px;
        border-radius: 14px;
        border: 1.5px solid #eee;
        background: #f8f9ff;
        color: #666;
        font-size: 14px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        transition: background 0.18s, color 0.18s, border-color 0.18s;
        white-space: nowrap;
    }

        .btn-tl-back:hover {
            background: #f0f2ff;
            color: #4361ee;
            border-color: #c5caff;
        }
</style>

<div class="tl-create-wrap">

    <!-- Header -->
    <div class="tl-create-header">
        <div class="icon-wrap"><i class="fas fa-edit"></i></div>
        <div>
            <h2>Chỉnh sửa thể loại</h2>
            <p>Cập nhật thông tin thể loại sản phẩm</p>
        </div>
    </div>

    <!-- Panel -->
    <div class="tl-create-panel">

        <!-- Validation errors -->
        <div asp-validation-summary="All" class="tl-validation" style="display:none;"></div>

        <form method="post" asp-action="Edit">
            @Html.AntiForgeryToken()

            <!-- Tên thể loại -->
            <div class="tl-form-group">
                <label>
                    <i class="fas fa-tag"></i> Tên thể loại
                </label>
                <input asp-for="Name" type="text" class="tl-input"
                       placeholder="Nhập tên thể loại..." />
                <span asp-validation-for="Name" class="tl-field-error"></span>
            </div>

            <!-- Ngày tạo -->
            <div class="tl-form-group">
                <label>
                    <i class="fas fa-calendar-alt"></i> Ngày tạo
                </label>
                <input asp-for="DateCreated" type="date" class="tl-input" />
                <span asp-validation-for="DateCreated" class="tl-field-error"></span>
            </div>

            <hr class="tl-divider">

            <!-- Actions -->
            <div class="tl-form-actions">
                <a asp-action="Index" class="btn-tl-back">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>
                <button type="submit" class="btn-tl-submit">
                    <i class="fas fa-save"></i> Lưu thay đổi
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Hiện validation summary nếu có lỗi
        var summary = document.querySelector('.tl-validation');
        if (summary && summary.querySelectorAll('li').length > 0) {
            summary.style.display = 'block';
        }
    </script>
}
