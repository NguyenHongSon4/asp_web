@model TheLoai

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    .tl-del-wrap {
        font-family: 'Be Vietnam Pro', sans-serif;
        max-width: 520px;
        margin: 0 auto;
        padding-bottom: 60px;
    }

    /* ── Header ── */
    .tl-del-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 28px;
    }

        .tl-del-header .icon-wrap {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #e63946, #c1121f);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 19px;
            flex-shrink: 0;
            box-shadow: 0 4px 14px rgba(230,57,70,0.35);
        }

        .tl-del-header h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0;
        }

        .tl-del-header p {
            font-size: 13px;
            color: #aaa;
            margin: 2px 0 0;
        }

    /* ── Warning box ── */
    .tl-del-warning {
        background: #fff5f5;
        border: 1.5px solid #ffc5c8;
        border-radius: 16px;
        padding: 16px 20px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 20px;
    }

        .tl-del-warning i {
            color: #e63946;
            font-size: 18px;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .tl-del-warning p {
            font-size: 13.5px;
            color: #c1121f;
            font-weight: 500;
            margin: 0;
            line-height: 1.6;
        }

    /* ── Panel ── */
    .tl-del-panel {
        background: #fff;
        border-radius: 24px;
        padding: 28px 32px;
        box-shadow: 0 2px 24px rgba(0,0,0,0.07);
        border: 1.5px solid #eef0f8;
    }

    /* ── Info rows (readonly preview) ── */
    .tl-del-info-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 0;
        border-bottom: 1px solid #f5f5f8;
    }

        .tl-del-info-row:last-of-type {
            border-bottom: none;
        }

    .tl-del-info-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: #fff0f1;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #e63946;
        font-size: 14px;
        flex-shrink: 0;
    }

    .tl-del-info-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #bbb;
        margin-bottom: 2px;
    }

    .tl-del-info-value {
        font-size: 14.5px;
        font-weight: 600;
        color: #1a1a2e;
    }

        .tl-del-info-value.id-pill {
            display: inline-flex;
            align-items: center;
            background: #fff0f1;
            color: #e63946;
            font-size: 13px;
            padding: 3px 12px;
            border-radius: 20px;
            border: 1.5px solid #ffc5c8;
            font-weight: 700;
        }

    /* ── Divider ── */
    .tl-divider {
        border: none;
        border-top: 1.5px solid #f0f2f8;
        margin: 22px 0;
    }

    /* ── Actions ── */
    .tl-del-actions {
        display: flex;
        gap: 10px;
    }

    .btn-tl-cancel {
        flex: 1;
        height: 48px;
        border-radius: 14px;
        border: 1.5px solid #eee;
        background: #f8f9ff;
        color: #555;
        font-size: 14px;
        font-weight: 600;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        transition: background 0.18s, color 0.18s, border-color 0.18s;
    }

        .btn-tl-cancel:hover {
            background: #f0f2ff;
            color: #4361ee;
            border-color: #c5caff;
        }

    .btn-tl-confirm-del {
        flex: 1;
        height: 48px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #e63946, #c1121f);
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        font-family: 'Be Vietnam Pro', sans-serif;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 4px 14px rgba(230,57,70,0.35);
        transition: opacity 0.18s, transform 0.15s;
    }

        .btn-tl-confirm-del:hover {
            opacity: 0.88;
            transform: translateY(-1px);
        }
</style>

<div class="tl-del-wrap">

    <!-- Header -->
    <div class="tl-del-header">
        <div class="icon-wrap"><i class="fas fa-trash-alt"></i></div>
        <div>
            <h2>Xóa thể loại</h2>
            <p>Hành động này không thể hoàn tác</p>
        </div>
    </div>

    <!-- Warning -->
    <div class="tl-del-warning">
        <i class="fas fa-exclamation-triangle"></i>
        <p>Bạn đang chuẩn bị xóa thể loại <strong>"@Model.Name"</strong>. Thao tác này sẽ xóa vĩnh viễn và không thể khôi phục lại.</p>
    </div>

    <!-- Panel -->
    <div class="tl-del-panel">

        <!-- Preview thông tin sẽ bị xóa -->
        <div class="tl-del-info-row">
            <div class="tl-del-info-icon"><i class="fas fa-hashtag"></i></div>
            <div>
                <div class="tl-del-info-label">Mã thể loại</div>
                <span class="tl-del-info-value id-pill">#@Model.Id</span>
            </div>
        </div>
        <div class="tl-del-info-row">
            <div class="tl-del-info-icon"><i class="fas fa-tag"></i></div>
            <div>
                <div class="tl-del-info-label">Tên thể loại</div>
                <div class="tl-del-info-value">@Model.Name</div>
            </div>
        </div>
        <div class="tl-del-info-row">
            <div class="tl-del-info-icon"><i class="fas fa-calendar-alt"></i></div>
            <div>
                <div class="tl-del-info-label">Ngày tạo</div>
                <div class="tl-del-info-value">@String.Format("{0:dd/MM/yyyy}", Model.DateCreated)</div>
            </div>
        </div>

        <hr class="tl-divider">

        <!-- Form submit -->
        <form method="post" asp-action="DeleteConfirm">
            <input asp-for="Id" type="hidden" />
            <input asp-for="Name" type="hidden" />
            <input asp-for="DateCreated" type="hidden" />

            <div class="tl-del-actions">
                <a asp-action="Index" class="btn-tl-cancel">
                    <i class="fas fa-times"></i> Hủy bỏ
                </a>
                <button type="submit" class="btn-tl-confirm-del">
                    <i class="fas fa-trash-alt"></i> Xác nhận xóa
                </button>
            </div>
        </form>
    </div>

</div>
